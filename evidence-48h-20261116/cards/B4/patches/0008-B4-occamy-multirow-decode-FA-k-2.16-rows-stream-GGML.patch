From c9e417a5232870dc53f0c07bfb1607184c2fdb39 Mon Sep 17 00:00:00 2001
From: author <noreply@example.invalid>
Date: Sun, 15 Nov 2026 22:44:03 +0100
Subject: [PATCH 8/8] B4: occamy multirow decode FA (k=2..16 rows/stream,
 GGML_CUDA_OFA_MULTIROW=1)

New ofa_decode_mr_kernel<R> (R rows per block, 4/R unit lanes x 2R query groups) and
ofa_combine_mr_kernel; rows share K/V loads (L1 within block, L2 across adjacent row
blocks), row r uses mask row r. k=1 path untouched. Engagement counter on power-of-two
calls. test-backend-ops mr_causal cases (2 streams, k=1..16, kv 4096/90112).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/fattn-occamy.cu | 261 ++++++++++++++++++++++++++++-
 tests/test-backend-ops.cpp         |  43 +++++
 2 files changed, 303 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/fattn-occamy.cu b/ggml/src/ggml-cuda/fattn-occamy.cu
index fd50ce8..28aac87 100644
--- a/ggml/src/ggml-cuda/fattn-occamy.cu
+++ b/ggml/src/ggml-cuda/fattn-occamy.cu
@@ -31,6 +31,8 @@
 #define OFA_NW  4
 #define OFA_T   4
 #define OFA_NT  (OFA_NW*32)
+// B4 multirow default rows per block (provisional until measured)
+#define OFA_MR_AUTO(k) ((k) % 4 == 0 || (k) == 3 ? 4 : 2)
 
 static __device__ __forceinline__ void ofa_cvt8(const uint4 w, float * f) {
     const half2 * h = (const half2 *) &w;
@@ -564,6 +566,194 @@ __global__ void __launch_bounds__(2*OFA_NT, 2) ofa_decode_hs_ar_kernel(const ofa
     }
 }
 
+// B4 (15 Nov 2026), GGML_CUDA_OFA_MULTIROW=1 with FA=1, PIPE=3, ADDR=1, F16 K/V: k = Q->ne[1] in [2,16] query rows per stream
+// (MTP verify / draft rows). Rows share K/V and differ only in Q and in the mask row (row r uses mask row r, Mb + r*nbm1),
+// so the causal offsets inside the k block come from the mask, as on the stock path. Block = 256 threads =
+// NWU = 4/R unit lanes x 2R query groups (R rows per block x 2 head groups of 4 q-heads). Every warp runs the
+// ofa_decode_hs_ar_kernel body for (row, head group) over the same unit lanes, so the K/V rows of one unit are fetched
+// from DRAM once per block and re-read by the other row warps from L1/tex. Grid x = split*nrb + row-block: the nrb row
+// blocks of one split are adjacent and co-resident, so with R < k they share K/V through L2. Rows >= k (padding of the
+// last row block) skip the KV loop. k = 1 never reaches this kernel (ofa_decode_hs_ar_kernel unchanged, bit-identical).
+// With R = 1 every row runs the exact hs_ar arithmetic (NWU = 4 lanes, same split, same order).
+// part_o [nblk][k][8][256], part_ml [nblk][k][8], blk = (i3*nkvh + kvh)*nsplit + split.
+template <int R>
+__global__ void __launch_bounds__(2*OFA_NT, 2) ofa_decode_mr_kernel(const ofa_params p, const int nrows) {
+    constexpr int NWU = OFA_NW / R;          // unit lanes
+    const int nrb   = (nrows + R - 1) / R;
+    const int split = blockIdx.x / nrb;
+    const int rb    = blockIdx.x % nrb;
+    const int kvh   = blockIdx.y;
+    const int i3    = blockIdx.z;
+    const int wid   = threadIdx.x >> 5;
+    const int warp  = wid % NWU;              // unit lane
+    const int qg    = wid / NWU;              // query group in [0, 2R)
+    const int rr    = qg >> 1;                // row within the row block
+    const int hg    = qg & 1;                 // head group
+    const int row   = rb*R + rr;
+    const bool live = row < nrows;
+    const int  rowc = live ? row : nrows - 1;
+    const int lane  = threadIdx.x & 31;
+
+    __shared__ __align__(16) float s_p[2*OFA_NW][OFA_T*OFA_HG];
+    __shared__ __align__(16) float s_a[2*OFA_NW][OFA_HG];
+    __shared__ float  s_o[NWU][R*OFA_G][OFA_D];
+    __shared__ float  s_m[NWU][R*OFA_G];
+    __shared__ float  s_l[NWU][R*OFA_G];
+
+    float q[OFA_HG][8];
+#pragma unroll
+    for (int h = 0; h < OFA_HG; ++h) {
+        const float4 * qp = (const float4 *) (p.Q + i3*p.nbq3 + rowc*p.nbq1 + (size_t)(kvh*OFA_G + hg*OFA_HG + h)*p.nbq2) + 2*lane;
+        const float4 a = qp[0], b = qp[1];
+        q[h][0] = a.x*p.scale_log2; q[h][1] = a.y*p.scale_log2; q[h][2] = a.z*p.scale_log2; q[h][3] = a.w*p.scale_log2;
+        q[h][4] = b.x*p.scale_log2; q[h][5] = b.y*p.scale_log2; q[h][6] = b.z*p.scale_log2; q[h][7] = b.w*p.scale_log2;
+    }
+    float o[OFA_HG][8];
+#pragma unroll
+    for (int h = 0; h < OFA_HG; ++h) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) o[h][i] = 0.0f;
+    }
+    const int   jl = lane >> 3;
+    float m_run = -FLT_MAX/2.0f;
+    float l_run = 0.0f;
+
+    const char * Kb = p.K + i3*p.nbk3 + kvh*p.nbk2 + lane*16;
+    const char * Vb = p.V + i3*p.nbv3 + kvh*p.nbv2 + lane*16;
+    const half * Mb = (const half *) (p.mask + (i3 % p.mask_ne3)*p.nbm3 + rowc*p.nbm1);
+
+    const int nunits = p.n_kv / OFA_T;
+    const int u0 = (int) (((long long) split      * nunits) / p.nsplit);
+    const int u1 = live ? (int) (((long long)(split + 1) * nunits) / p.nsplit) : u0;
+
+    const size_t nbk1 = p.nbk1, nbv1 = p.nbv1;
+    const char * kp = Kb + (size_t)(u0 + warp)*OFA_T*nbk1;
+    const char * vp = Vb + (size_t)(u0 + warp)*OFA_T*nbv1;
+    const half * mp = Mb + (u0 + warp)*OFA_T + jl;
+    const size_t kstep = (size_t) NWU*OFA_T*nbk1;
+    const size_t vstep = (size_t) NWU*OFA_T*nbv1;
+    for (int u = u0 + warp; u < u1; u += NWU, kp += kstep, vp += vstep, mp += NWU*OFA_T) {
+        uint4 kr[OFA_T], vr[OFA_T];
+        {
+            const char * r = kp;
+#pragma unroll
+            for (int j = 0; j < OFA_T; ++j, r += nbk1) kr[j] = __ldg((const uint4 *) r);
+        }
+        {
+            const char * r = vp;
+#pragma unroll
+            for (int j = 0; j < OFA_T; ++j, r += nbv1) vr[j] = __ldg((const uint4 *) r);
+        }
+        const float mk = __half2float(*mp);
+
+        float s[OFA_T*OFA_HG];
+#pragma unroll
+        for (int j = 0; j < OFA_T; ++j) {
+            float k[8];
+            ofa_cvt8(kr[j], k);
+#pragma unroll
+            for (int h = 0; h < OFA_HG; ++h) {
+                float acc = q[h][0]*k[0];
+#pragma unroll
+                for (int i = 1; i < 8; ++i) acc = fmaf(q[h][i], k[i], acc);
+                s[j*OFA_HG + h] = acc;
+            }
+        }
+        ofa_rs_step_x<8, 16>(s, lane);
+        ofa_rs_step_x<4,  8>(s, lane);
+        ofa_rs_step_x<2,  4>(s, lane);
+        ofa_rs_step_x<1,  2>(s, lane);
+        s[0] = s[0] + __shfl_xor_sync(0xFFFFFFFF, s[0], 1, 32);
+        const float sc = s[0] + mk*1.4426950408889634f;
+        float gm = fmaxf(sc, __shfl_xor_sync(0xFFFFFFFF, sc, 8, 32));
+        gm = fmaxf(gm, __shfl_xor_sync(0xFFFFFFFF, gm, 16, 32));
+        const float m_new = fmaxf(m_run, gm);
+        const float alpha = exp2f(m_run - m_new);
+        const float pr    = exp2f(sc - m_new);
+        m_run = m_new;
+        l_run = l_run*alpha + pr;
+        if (!(lane & 1)) s_p[wid][lane >> 1] = pr;
+        if (lane < 2*OFA_HG && !(lane & 1)) s_a[wid][lane >> 1] = alpha;
+        __syncwarp();
+        float a[OFA_HG];
+        {
+            const float4 a0 = *(const float4 *) &s_a[wid][0];
+            a[0] = a0.x; a[1] = a0.y; a[2] = a0.z; a[3] = a0.w;
+        }
+#pragma unroll
+        for (int h = 0; h < OFA_HG; ++h) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) o[h][i] *= a[h];
+        }
+#pragma unroll
+        for (int j = 0; j < OFA_T; ++j) {
+            float v[8];
+            ofa_cvt8(vr[j], v);
+            const float4 p0 = *(const float4 *) &s_p[wid][j*OFA_HG];
+            const float pj[4] = {p0.x, p0.y, p0.z, p0.w};
+#pragma unroll
+            for (int h = 0; h < OFA_HG; ++h) {
+#pragma unroll
+                for (int i = 0; i < 8; ++i) o[h][i] = fmaf(pj[h], v[i], o[h][i]);
+            }
+        }
+        __syncwarp();
+    }
+
+    l_run += __shfl_xor_sync(0xFFFFFFFF, l_run, 8, 32);
+    l_run += __shfl_xor_sync(0xFFFFFFFF, l_run, 16, 32);
+    const int qb = rr*OFA_G + hg*OFA_HG;      // q-head slot within the row block
+    if (lane < 2*OFA_HG && !(lane & 1)) { s_m[warp][qb + (lane >> 1)] = m_run; s_l[warp][qb + (lane >> 1)] = l_run; }
+#pragma unroll
+    for (int h = 0; h < OFA_HG; ++h) {
+        float4 * dp = (float4 *) &s_o[warp][qb + h][8*lane];
+        dp[0] = make_float4(o[h][0], o[h][1], o[h][2], o[h][3]);
+        dp[1] = make_float4(o[h][4], o[h][5], o[h][6], o[h][7]);
+    }
+    __syncthreads();
+
+    const int blk  = (i3*p.nkvh + kvh)*p.nsplit + split;
+    const int nliv = min(R, nrows - rb*R);
+    for (int idx = threadIdx.x; idx < nliv*OFA_G*OFA_D; idx += 2*OFA_NT) {
+        const int hh = idx / OFA_D, d = idx % OFA_D;   // hh = rr*8 + h
+        const int r = rb*R + hh / OFA_G, h = hh % OFA_G;
+        float M = s_m[0][hh];
+#pragma unroll
+        for (int w = 1; w < NWU; ++w) M = fmaxf(M, s_m[w][hh]);
+        float acc = 0.0f;
+#pragma unroll
+        for (int w = 0; w < NWU; ++w) acc += s_o[w][hh][d]*exp2f(s_m[w][hh] - M);
+        const size_t slot = ((size_t) blk*nrows + r)*OFA_G + h;
+        p.part_o[slot*OFA_D + d] = acc;
+        if (d == 0) {
+            float L = 0.0f;
+#pragma unroll
+            for (int w = 0; w < NWU; ++w) L += s_l[w][hh]*exp2f(s_m[w][hh] - M);
+            p.part_ml[slot] = make_float2(M, L);
+        }
+    }
+}
+
+// grid (nkvh*8 q-heads, nrows, ns), block 256 = one thread per dim; same split order as ofa_combine_kernel.
+__global__ void __launch_bounds__(OFA_D) ofa_combine_mr_kernel(const float * __restrict__ part_o, const float2 * __restrict__ part_ml,
+        char * __restrict__ dst, const int nsplit, const int nkvh, const int nrows, const size_t nbd1, const size_t nbd2, const size_t nbd3) {
+    const int qh = blockIdx.x, r = blockIdx.y, i3 = blockIdx.z, d = threadIdx.x;
+    const int kvh = qh / OFA_G, h = qh % OFA_G;
+    const int blk0 = (i3*nkvh + kvh)*nsplit;
+    float M = -FLT_MAX;
+    for (int s = 0; s < nsplit; ++s) M = fmaxf(M, part_ml[((size_t)(blk0 + s)*nrows + r)*OFA_G + h].x);
+    float L = 0.0f, acc = 0.0f;
+    for (int s = 0; s < nsplit; ++s) {
+        const size_t slot = ((size_t)(blk0 + s)*nrows + r)*OFA_G + h;
+        const float2 ml = part_ml[slot];
+        const float  w  = exp2f(ml.x - M);
+        L   += ml.y*w;
+        acc += part_o[slot*OFA_D + d]*w;
+    }
+    float * out = (float *) (dst + i3*nbd3 + r*nbd2 + qh*nbd1);
+    out[d] = L > 0.0f ? acc/L : 0.0f;
+}
+
 // Card 14 (14 Nov 2026), GGML_CUDA_OFA_RAGGED=1 with FA=1, PIPE=3, ADDR=1, F16 K/V, ne3 (streams) >= 2: ragged two-slot split.
 // For ne3>=2 every stream used to read n_kv = max over streams rows; the shorter stream streamed its trailing fully masked rows.
 // (1) ofa_len_kernel: L[s] = 1 + last mask column of stream s (row 0) that is not -inf, rounded up to OFA_T, capped at n_kv.
@@ -1015,6 +1205,27 @@ int ggml_cuda_occamy_fa_mode() {
     return v;
 }
 
+// B4: GGML_CUDA_OFA_MULTIROW must be exactly "1"; acts only with GGML_CUDA_OCCAMY_FA_PIPE=3 and GGML_CUDA_OCCAMY_FA_ADDR!=0 (F16 K/V).
+// GGML_CUDA_OFA_MR_R=1|2|4 forces the rows per block (default: auto, ofa_mr_pick).
+static bool ofa_mr_enabled() {
+    static const bool v = []() {
+        const char * s  = getenv("GGML_CUDA_OFA_MULTIROW");
+        const char * sp = getenv("GGML_CUDA_OCCAMY_FA_PIPE");
+        const char * sa = getenv("GGML_CUDA_OCCAMY_FA_ADDR");
+        const bool on = s && strcmp(s, "1") == 0;
+        const bool ok = on && sp && atoi(sp) == 3 && sa && atoi(sa) != 0;
+        if (on) fprintf(stderr, "ggml_cuda: occamy FA multirow %s\n", ok ? "on (k = 2..16 rows)" : "requested but inactive (needs PIPE=3, ADDR=1)");
+        return ok;
+    }();
+    return v;
+}
+
+static int ofa_mr_pick(const int k) {
+    static const int force = []() { const char * e = getenv("GGML_CUDA_OFA_MR_R"); const int r = e ? atoi(e) : 0; return (r == 1 || r == 2 || r == 4) ? r : 0; }();
+    if (force) return force;
+    return OFA_MR_AUTO(k);
+}
+
 bool ggml_cuda_occamy_fa_applicable(const ggml_tensor * dst) {
     const ggml_tensor * Q = dst->src[0];
     const ggml_tensor * K = dst->src[1];
@@ -1027,10 +1238,11 @@ bool ggml_cuda_occamy_fa_applicable(const ggml_tensor * dst) {
     if (Q->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 || dst->type != GGML_TYPE_F32) return false;
     if (K->ne[0] != OFA_D || V->ne[0] != OFA_D || Q->ne[0] != OFA_D) return false;
     if (K->ne[2] != V->ne[2] || Q->ne[2] != OFA_G*K->ne[2]) return false;
-    if (Q->ne[1] != 1) return false;
+    if (Q->ne[1] != 1 && !(Q->ne[1] >= 2 && Q->ne[1] <= 16 && ofa_mr_enabled())) return false;
     if (K->ne[3] != Q->ne[3] || V->ne[3] != Q->ne[3] || K->ne[1] != V->ne[1]) return false;
     if (K->ne[1] % OFA_T != 0) return false;
     if (!mask || mask->type != GGML_TYPE_F16 || mask->ne[2] != 1 || mask->ne[0] < K->ne[1]) return false;
+    if (Q->ne[1] != 1 && (mask->ne[1] < Q->ne[1] || mask->nb[1] % 2 != 0)) return false;
     if (Q->ne[3] % mask->ne[3] != 0) return false;
     if (sinks || max_bias != 0.0f || softcap != 0.0f) return false;
     if (Q->nb[0] != 4 || K->nb[0] != 2 || V->nb[0] != 2 || dst->nb[0] != 4) return false;
@@ -1158,6 +1370,53 @@ static void ofa_launch(ggml_backend_cuda_context & ctx, const ggml_tensor * dst,
     const int ns   = (int) Q->ne[3];
     const int n_kv = (int) K->ne[1];
 
+    const int nrows = (int) Q->ne[1];
+    if (nrows > 1) {
+        // B4 multirow path (applicability already required MULTIROW=1, PIPE=3, ADDR=1, F16 K/V, 2 <= k <= 16)
+        GGML_ASSERT(!kvq8 && pipe == 3 && addr && nrows <= 16);
+        static long long mr_calls = 0;
+        static int mr_occ[5] = {0, 0, 0, 0, 0};
+        if (mr_occ[1] == 0) {
+            CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&mr_occ[1], ofa_decode_mr_kernel<1>, 2*OFA_NT, 0));
+            CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&mr_occ[2], ofa_decode_mr_kernel<2>, 2*OFA_NT, 0));
+            CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&mr_occ[4], ofa_decode_mr_kernel<4>, 2*OFA_NT, 0));
+            fprintf(stderr, "ggml_cuda: occamy FA multirow blocks/SM R1 %d R2 %d R4 %d\n", mr_occ[1], mr_occ[2], mr_occ[4]);
+        }
+        const int R   = ofa_mr_pick(nrows);
+        const int nrb = (nrows + R - 1) / R;
+        int nsplit = (resident*waves + nkvh*ns*nrb - 1) / (nkvh*ns*nrb);
+        nsplit = std::max(1, std::min(nsplit, n_kv / (OFA_T*OFA_NW*4)));
+        const int nblk = nsplit*nkvh*ns;
+        ggml_cuda_pool_alloc<float>  part_o (ctx.pool(), (size_t) nblk*nrows*OFA_G*OFA_D);
+        ggml_cuda_pool_alloc<float2> part_ml(ctx.pool(), (size_t) nblk*nrows*OFA_G);
+        float scale;
+        memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+        ofa_params p;
+        p.Q = (const char *) Q->data; p.K = (const char *) K->data; p.V = (const char *) V->data; p.mask = (const char *) mask->data;
+        p.part_o = part_o.get(); p.part_ml = part_ml.get();
+        p.n_kv = n_kv; p.nsplit = nsplit; p.nkvh = nkvh; p.mask_ne1 = (int) mask->ne[1]; p.mask_ne3 = (int) mask->ne[3];
+        p.scale_log2 = scale*1.4426950408889634f;
+        p.nbq1 = Q->nb[1]; p.nbq2 = Q->nb[2]; p.nbq3 = Q->nb[3];
+        p.nbk1 = K->nb[1]; p.nbk2 = K->nb[2]; p.nbk3 = K->nb[3];
+        p.nbv1 = V->nb[1]; p.nbv2 = V->nb[2]; p.nbv3 = V->nb[3];
+        p.nbm1 = mask->nb[1]; p.nbm3 = mask->nb[3];
+        const dim3 grid(nsplit*nrb, nkvh, ns);
+        switch (R) {
+            case 1:  ofa_decode_mr_kernel<1><<<grid, 2*OFA_NT, 0, stream>>>(p, nrows); break;
+            case 2:  ofa_decode_mr_kernel<2><<<grid, 2*OFA_NT, 0, stream>>>(p, nrows); break;
+            default: ofa_decode_mr_kernel<4><<<grid, 2*OFA_NT, 0, stream>>>(p, nrows); break;
+        }
+        CUDA_CHECK(cudaGetLastError());
+        ofa_combine_mr_kernel<<<dim3(nkvh*OFA_G, nrows, ns), OFA_D, 0, stream>>>(part_o.get(), part_ml.get(), out, nsplit, nkvh, nrows,
+            dst->nb[1], dst->nb[2], dst->nb[3]);
+        CUDA_CHECK(cudaGetLastError());
+        ++mr_calls;
+        if ((mr_calls & (mr_calls - 1)) == 0) {
+            fprintf(stderr, "ggml_cuda: occamy FA multirow on: engaged=%lld k=%d R=%d ns=%d n_kv=%d nsplit=%d nkvh=%d\n", mr_calls, nrows, R, ns, n_kv, nsplit, nkvh);
+        }
+        return;
+    }
+
     if (ragged && !kvq8 && ns >= 2 && mask->type == GGML_TYPE_F16 && (int) mask->ne[1] >= 1 && n_kv % 4 == 0 &&
             mask->nb[3] % 8 == 0 && ((uintptr_t) mask->data) % 8 == 0) {
         int nb = (resident*waves + nkvh - 1) / nkvh;
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index ec504c8..6e01f08 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -8492,6 +8492,37 @@ struct test_flash_attn_ext_maxwell_causal : public test_flash_attn_ext {
     }
 };
 
+// B4 occamy multirow decode (GGML_CUDA_OFA_MULTIROW=1, FA=1, PIPE=3, ADDR=1): k = nb draft rows per stream,
+// causal inside the k block (row r sees keys <= kv - nb + r - s*gap for stream s), so rows differ only by their mask row.
+struct test_flash_attn_ext_mr_causal : public test_flash_attn_ext {
+    using test_flash_attn_ext::test_flash_attn_ext;
+
+    std::string vars() override {
+        return test_flash_attn_ext::vars() + ",mask=mr_causal";
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_ext::initialize_tensors(ctx);
+        ggml_tensor * m = ggml_get_tensor(ctx, "m");
+        if (!m) {
+            return;
+        }
+        const int64_t ne0 = m->ne[0], ne1 = m->ne[1], ne3 = m->ne[3];
+        std::vector<float> data_f32(ne0*ne1*ne3);
+        std::vector<ggml_fp16_t> data_f16(data_f32.size());
+        for (int64_t s = 0; s < ne3; ++s) {
+            for (int64_t row = 0; row < ne1; ++row) {
+                const int64_t last = ne0 - ne1 + row - s*777;
+                for (int64_t key = 0; key < ne0; ++key) {
+                    data_f32[(s*ne1 + row)*ne0 + key] = key > last ? -INFINITY : -0.0625f * float((key + row) % 5);
+                }
+            }
+        }
+        ggml_fp32_to_fp16_row(data_f32.data(), data_f16.data(), data_f16.size());
+        ggml_backend_tensor_set(m, data_f16.data(), 0, data_f16.size()*sizeof(ggml_fp16_t));
+    }
