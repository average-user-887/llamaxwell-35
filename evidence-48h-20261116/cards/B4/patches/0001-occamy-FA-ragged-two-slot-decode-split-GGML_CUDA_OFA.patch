From 6b837ea447d32b759932af3eb01b686eb7c7d5db Mon Sep 17 00:00:00 2001
From: author <noreply@example.invalid>
Date: Sat, 14 Nov 2026 20:26:44 +0100
Subject: [PATCH 1/8] occamy FA: ragged two-slot decode split
 (GGML_CUDA_OFA_RAGGED=1, default off)

ns>=2 decode with F16 K/V, PIPE=3 ADDR=1: per-stream length from the mask
(last non -inf column), one global unit space over all streams split across
NB=resident/nkvh blocks, combine merges only blocks touching the stream.
ns==1 and flag-off paths unchanged (hs_ar kernel untouched).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/fattn-occamy.cu | 263 +++++++++++++++++++++++++++++
 1 file changed, 263 insertions(+)

diff --git a/ggml/src/ggml-cuda/fattn-occamy.cu b/ggml/src/ggml-cuda/fattn-occamy.cu
index 513bb31..d564f70 100644
--- a/ggml/src/ggml-cuda/fattn-occamy.cu
+++ b/ggml/src/ggml-cuda/fattn-occamy.cu
@@ -563,6 +563,224 @@ __global__ void __launch_bounds__(2*OFA_NT, 2) ofa_decode_hs_ar_kernel(const ofa
     }
 }
 
+// Card 14 (14 Nov 2026), GGML_CUDA_OFA_RAGGED=1 with FA=1, PIPE=3, ADDR=1, F16 K/V, ne3 (streams) >= 2: ragged two-slot split.
+// For ne3>=2 every stream used to read n_kv = max over streams rows; the shorter stream streamed its trailing fully masked rows.
+// (1) ofa_len_kernel: L[s] = 1 + last mask column of stream s (row 0) that is not -inf, rounded up to OFA_T, capped at n_kv.
+// (2) ofa_decode_rg_kernel: grid (NB, nkvh). The units of all streams are concatenated [s0 | s1 | ...] (U = sum L[s]/OFA_T);
+//     block b takes global units [b*U/NB, (b+1)*U/NB) and runs the hs_ar body + epilogue once per stream segment it touches
+//     (partial slot (s*nkvh + kvh)*NB + b). Rows >= L[s] are all -inf, so skipping them is exact; holes below L[s] stay masked.
+// (3) ofa_combine_rg_kernel: recomputes each stream's block set from L[] (same integer formula) and merges.
+// Not bitwise vs hs_ar for ne3>=2 (split boundaries move); ne3==1 never comes here (hs_ar, unchanged).
+static __device__ __forceinline__ void ofa_rg_range(const int * __restrict__ L, const int ns, const int nb, const int b, const int s,
+        int & a, int & c) {
+    long long U = 0, off = 0;
+    for (int t = 0; t < ns; ++t) { const int ut = L[t] / OFA_T; if (t < s) off += ut; U += ut; }
+    const long long us = L[s] / OFA_T;
+    const long long g0 = ((long long) b      *U)/nb;
+    const long long g1 = ((long long)(b + 1) *U)/nb;
+    a = (int) (max(g0, off) - off);
+    c = (int) (min(g1, off + us) - off);
+}
+
+// grid ns, block 1024: mask row 0 of stream s, 4 halves per load (n_kv % 4 == 0, row base 8-B aligned, checked on the host)
+__global__ void __launch_bounds__(1024) ofa_len_kernel(const char * __restrict__ mask, const size_t nbm3, const int mask_ne3,
+        const int n_kv, int * __restrict__ L) {
+    const int s = blockIdx.x;
+    const uint2 * m = (const uint2 *) (mask + (size_t)(s % mask_ne3)*nbm3);
+    int last = -1;
+    for (int i = threadIdx.x; i < n_kv/4; i += blockDim.x) {
+        const uint2 w = m[i];
+        if ((w.y >> 16)     != 0xFC00u) last = 4*i + 3;
+        else if ((w.y & 0xFFFFu) != 0xFC00u) last = 4*i + 2;
+        else if ((w.x >> 16)     != 0xFC00u) last = 4*i + 1;
+        else if ((w.x & 0xFFFFu) != 0xFC00u) last = 4*i + 0;
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) last = max(last, __shfl_xor_sync(0xFFFFFFFF, last, o, 32));
+    __shared__ int s_last[32];
+    if ((threadIdx.x & 31) == 0) s_last[threadIdx.x >> 5] = last;
+    __syncthreads();
+    if (threadIdx.x < 32) {
+        last = threadIdx.x < (blockDim.x >> 5) ? s_last[threadIdx.x] : -1;
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) last = max(last, __shfl_xor_sync(0xFFFFFFFF, last, o, 32));
+        if (threadIdx.x == 0) L[s] = min(((last + 1) + OFA_T - 1) & ~(OFA_T - 1), n_kv);
+    }
+}
+
+// body = ofa_decode_hs_ar_kernel's, run per stream segment [u0, u1) with partial slot blk; p.nsplit = NB
+__global__ void __launch_bounds__(2*OFA_NT, 2) ofa_decode_rg_kernel(const ofa_params p, const int * __restrict__ Ls, const int ns) {
+    const int b     = blockIdx.x;
+    const int kvh   = blockIdx.y;
+    const int wid   = threadIdx.x >> 5;
+    const int warp  = wid & (OFA_NW - 1);
+    const int hg    = wid / OFA_NW;
+    const int lane  = threadIdx.x & 31;
+
+    __shared__ __align__(16) float s_p[2*OFA_NW][OFA_T*OFA_HG];
+    __shared__ __align__(16) float s_a[2*OFA_NW][OFA_HG];
+    __shared__ float  s_o[OFA_NW][OFA_G][OFA_D];
+    __shared__ float  s_m[OFA_NW][OFA_G];
+    __shared__ float  s_l[OFA_NW][OFA_G];
+
+    for (int i3 = 0; i3 < ns; ++i3) {
+        int u0, u1;
+        ofa_rg_range(Ls, ns, p.nsplit, b, i3, u0, u1);
+        if (u0 >= u1) continue;   // block-uniform
+
+        float q[OFA_HG][8];
+#pragma unroll
+        for (int h = 0; h < OFA_HG; ++h) {
+            const float4 * qp = (const float4 *) (p.Q + i3*p.nbq3 + (size_t)(kvh*OFA_G + hg*OFA_HG + h)*p.nbq2) + 2*lane;
+            const float4 a = qp[0], bq = qp[1];
+            q[h][0] = a.x*p.scale_log2;  q[h][1] = a.y*p.scale_log2;  q[h][2] = a.z*p.scale_log2;  q[h][3] = a.w*p.scale_log2;
+            q[h][4] = bq.x*p.scale_log2; q[h][5] = bq.y*p.scale_log2; q[h][6] = bq.z*p.scale_log2; q[h][7] = bq.w*p.scale_log2;
+        }
+        float o[OFA_HG][8];
+#pragma unroll
+        for (int h = 0; h < OFA_HG; ++h) {
+#pragma unroll
+            for (int i = 0; i < 8; ++i) o[h][i] = 0.0f;
+        }
+        const int   jl = lane >> 3;
+        float m_run = -FLT_MAX/2.0f;
+        float l_run = 0.0f;
+
+        const char * Kb = p.K + i3*p.nbk3 + kvh*p.nbk2 + lane*16;
+        const char * Vb = p.V + i3*p.nbv3 + kvh*p.nbv2 + lane*16;
+        const half * Mb = (const half *) (p.mask + (i3 % p.mask_ne3)*p.nbm3);
+
+        const size_t nbk1 = p.nbk1, nbv1 = p.nbv1;
+        const char * kp = Kb + (size_t)(u0 + warp)*OFA_T*nbk1;
+        const char * vp = Vb + (size_t)(u0 + warp)*OFA_T*nbv1;
+        const half * mp = Mb + (u0 + warp)*OFA_T + jl;
+        const size_t kstep = (size_t) OFA_NW*OFA_T*nbk1;
+        const size_t vstep = (size_t) OFA_NW*OFA_T*nbv1;
+        for (int u = u0 + warp; u < u1; u += OFA_NW, kp += kstep, vp += vstep, mp += OFA_NW*OFA_T) {
+            uint4 kr[OFA_T], vr[OFA_T];
+            {
+                const char * r = kp;
+#pragma unroll
+                for (int j = 0; j < OFA_T; ++j, r += nbk1) kr[j] = __ldg((const uint4 *) r);
+            }
+            {
+                const char * r = vp;
+#pragma unroll
+                for (int j = 0; j < OFA_T; ++j, r += nbv1) vr[j] = __ldg((const uint4 *) r);
+            }
+            const float mk = __half2float(*mp);
+
+            float s[OFA_T*OFA_HG];
+#pragma unroll
+            for (int j = 0; j < OFA_T; ++j) {
+                float k[8];
+                ofa_cvt8(kr[j], k);
+#pragma unroll
+                for (int h = 0; h < OFA_HG; ++h) {
+                    float acc = q[h][0]*k[0];
+#pragma unroll
+                    for (int i = 1; i < 8; ++i) acc = fmaf(q[h][i], k[i], acc);
+                    s[j*OFA_HG + h] = acc;
+                }
+            }
+            ofa_rs_step_x<8, 16>(s, lane);
+            ofa_rs_step_x<4,  8>(s, lane);
+            ofa_rs_step_x<2,  4>(s, lane);
+            ofa_rs_step_x<1,  2>(s, lane);
+            s[0] = s[0] + __shfl_xor_sync(0xFFFFFFFF, s[0], 1, 32);
+            const float sc = s[0] + mk*1.4426950408889634f;
+            float gm = fmaxf(sc, __shfl_xor_sync(0xFFFFFFFF, sc, 8, 32));
+            gm = fmaxf(gm, __shfl_xor_sync(0xFFFFFFFF, gm, 16, 32));
+            const float m_new = fmaxf(m_run, gm);
+            const float alpha = exp2f(m_run - m_new);
+            const float pr    = exp2f(sc - m_new);
+            m_run = m_new;
+            l_run = l_run*alpha + pr;
+            if (!(lane & 1)) s_p[wid][lane >> 1] = pr;
+            if (lane < 2*OFA_HG && !(lane & 1)) s_a[wid][lane >> 1] = alpha;
+            __syncwarp();
+            float a[OFA_HG];
+            {
+                const float4 a0 = *(const float4 *) &s_a[wid][0];
+                a[0] = a0.x; a[1] = a0.y; a[2] = a0.z; a[3] = a0.w;
+            }
+#pragma unroll
+            for (int h = 0; h < OFA_HG; ++h) {
+#pragma unroll
+                for (int i = 0; i < 8; ++i) o[h][i] *= a[h];
+            }
+#pragma unroll
+            for (int j = 0; j < OFA_T; ++j) {
+                float v[8];
+                ofa_cvt8(vr[j], v);
+                const float4 p0 = *(const float4 *) &s_p[wid][j*OFA_HG];
+                const float pj[4] = {p0.x, p0.y, p0.z, p0.w};
+#pragma unroll
+                for (int h = 0; h < OFA_HG; ++h) {
+#pragma unroll
+                    for (int i = 0; i < 8; ++i) o[h][i] = fmaf(pj[h], v[i], o[h][i]);
+                }
+            }
+            __syncwarp();
+        }
+
+        l_run += __shfl_xor_sync(0xFFFFFFFF, l_run, 8, 32);
+        l_run += __shfl_xor_sync(0xFFFFFFFF, l_run, 16, 32);
+        if (lane < 2*OFA_HG && !(lane & 1)) { s_m[warp][hg*OFA_HG + (lane >> 1)] = m_run; s_l[warp][hg*OFA_HG + (lane >> 1)] = l_run; }
+#pragma unroll
+        for (int h = 0; h < OFA_HG; ++h) {
+            float4 * dp = (float4 *) &s_o[warp][hg*OFA_HG + h][8*lane];
+            dp[0] = make_float4(o[h][0], o[h][1], o[h][2], o[h][3]);
+            dp[1] = make_float4(o[h][4], o[h][5], o[h][6], o[h][7]);
+        }
+        __syncthreads();
+
+        const int blk = (i3*p.nkvh + kvh)*p.nsplit + b;
+        float * po = p.part_o + (size_t) blk*OFA_G*OFA_D;
+        for (int idx = threadIdx.x; idx < OFA_G*OFA_D; idx += 2*OFA_NT) {
+            const int h = idx / OFA_D, d = idx % OFA_D;
+            float M = s_m[0][h];
+#pragma unroll
+            for (int w = 1; w < OFA_NW; ++w) M = fmaxf(M, s_m[w][h]);
+            float acc = 0.0f;
+#pragma unroll
+            for (int w = 0; w < OFA_NW; ++w) acc += s_o[w][h][d]*exp2f(s_m[w][h] - M);
+            po[idx] = acc;
+            if (d == 0) {
+                float L = 0.0f;
+#pragma unroll
+                for (int w = 0; w < OFA_NW; ++w) L += s_l[w][h]*exp2f(s_m[w][h] - M);
+                p.part_ml[(size_t) blk*OFA_G + h] = make_float2(M, L);
+            }
+        }
+        __syncthreads();   // s_o/s_m/s_l are rewritten by the next segment
+    }
+}
+
+// grid (nkvh*8 q-heads, ns), block 256; merges only the partials of blocks whose range touched stream i3
+__global__ void __launch_bounds__(OFA_D) ofa_combine_rg_kernel(const float * __restrict__ part_o, const float2 * __restrict__ part_ml,
+        char * __restrict__ dst, const int nb, const int nkvh, const int ns, const int * __restrict__ Ls, const size_t nbd1, const size_t nbd3) {
+    const int qh = blockIdx.x, i3 = blockIdx.y, d = threadIdx.x;
+    const int kvh = qh / OFA_G, h = qh % OFA_G;
+    const int blk0 = (i3*nkvh + kvh)*nb;
+    float M = -FLT_MAX;
+    for (int b = 0; b < nb; ++b) {
+        int a, c; ofa_rg_range(Ls, ns, nb, b, i3, a, c);
+        if (a < c) M = fmaxf(M, part_ml[(size_t)(blk0 + b)*OFA_G + h].x);
+    }
+    float L = 0.0f, acc = 0.0f;
+    for (int b = 0; b < nb; ++b) {
+        int a, c; ofa_rg_range(Ls, ns, nb, b, i3, a, c);
+        if (a >= c) continue;
+        const float2 ml = part_ml[(size_t)(blk0 + b)*OFA_G + h];
+        const float  w  = exp2f(ml.x - M);
+        L   += ml.y*w;
+        acc += part_o[((size_t)(blk0 + b)*OFA_G + h)*OFA_D + d]*w;
+    }
+    float * out = (float *) (dst + i3*nbd3 + qh*nbd1);
+    out[d] = L > 0.0f ? acc/L : 0.0f;
+}
+
 // Q8N (13 Nov 2026), GGML_CUDA_OCCAMY_KVQ8=1 (exact "1") with FA=1, PIPE=3, ADDR=1: the hs_ar kernel reading q8_0 K and/or V
 // natively (no f16 conversion of the cache). KQ8/VQ8 select the K/V row format independently (F16/F16 stays on
 // ofa_decode_hs_ar_kernel, untouched). Lane math: fattn-occamy-kvq8.cuh. K: the lane's 8-dim QK partial is computed on the
@@ -890,7 +1108,11 @@ static void ofa_launch(ggml_backend_cuda_context & ctx, const ggml_tensor * dst,
     static int waves = 1;
     static int pipe = 0;
     static int addr = 0;
+    static int ragged = 0;
+    static long long rg_calls = 0;
     if (resident == 0) {
+        const char * sr = getenv("GGML_CUDA_OFA_RAGGED");
+        ragged = (sr && atoi(sr) != 0) ? 1 : 0;
         int nb = 0;
         // occupancy of the flag-OFF kernel decides nsplit for every PIPE mode (same split -> same reduction);
         // the PIPE kernels must keep >= that occupancy, checked below.
@@ -923,10 +1145,51 @@ static void ofa_launch(ggml_backend_cuda_context & ctx, const ggml_tensor * dst,
             }
             fprintf(stderr, "ggml_cuda: occamy FA pipe mode %d (blocks/SM %d, flag-off %d)\n", pipe, nbp, nb);
         }
+        if (ragged) {
+            int nbr = 0;
+            CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&nbr, ofa_decode_rg_kernel, 2*OFA_NT, 0));
+            if (!(pipe == 3 && addr) || nbr < nb) ragged = 0;
+            fprintf(stderr, "ggml_cuda: occamy FA ragged %s (blocks/SM %d)\n",
+                ragged ? "requested, active for F16 K/V with ne3>=2" : "requested but inactive (needs PIPE=3, ADDR=1)", nbr);
+        }
     }
     const int nkvh = (int) K->ne[2];
     const int ns   = (int) Q->ne[3];
     const int n_kv = (int) K->ne[1];
+
+    if (ragged && !kvq8 && ns >= 2 && mask->type == GGML_TYPE_F16 && (int) mask->ne[1] >= 1 && n_kv % 4 == 0 &&
+            mask->nb[3] % 8 == 0 && ((uintptr_t) mask->data) % 8 == 0) {
+        int nb = (resident*waves + nkvh - 1) / nkvh;
+        nb = std::max(1, std::min(nb, ns*n_kv / (OFA_T*OFA_NW*4)));
+        const int nblk = nb*nkvh*ns;
+        ggml_cuda_pool_alloc<float>  part_o (ctx.pool(), (size_t) nblk*OFA_G*OFA_D);
+        ggml_cuda_pool_alloc<float2> part_ml(ctx.pool(), (size_t) nblk*OFA_G);
+        ggml_cuda_pool_alloc<int>    lens   (ctx.pool(), (size_t) ns);
+        float scale;
+        memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+        ofa_params p;
+        p.Q = (const char *) Q->data; p.K = (const char *) K->data; p.V = (const char *) V->data; p.mask = (const char *) mask->data;
+        p.part_o = part_o.get(); p.part_ml = part_ml.get();
+        p.n_kv = n_kv; p.nsplit = nb; p.nkvh = nkvh; p.mask_ne1 = (int) mask->ne[1]; p.mask_ne3 = (int) mask->ne[3];
+        p.scale_log2 = scale*1.4426950408889634f;
+        p.nbq1 = Q->nb[1]; p.nbq2 = Q->nb[2]; p.nbq3 = Q->nb[3];
+        p.nbk1 = K->nb[1]; p.nbk2 = K->nb[2]; p.nbk3 = K->nb[3];
+        p.nbv1 = V->nb[1]; p.nbv2 = V->nb[2]; p.nbv3 = V->nb[3];
+        p.nbm1 = mask->nb[1]; p.nbm3 = mask->nb[3];
+        ofa_len_kernel<<<ns, 1024, 0, stream>>>(p.mask, p.nbm3, p.mask_ne3, n_kv, lens.get());
+        CUDA_CHECK(cudaGetLastError());
+        ofa_decode_rg_kernel<<<dim3(nb, nkvh), 2*OFA_NT, 0, stream>>>(p, lens.get(), ns);
+        CUDA_CHECK(cudaGetLastError());
+        ofa_combine_rg_kernel<<<dim3(nkvh*OFA_G, ns), OFA_D, 0, stream>>>(part_o.get(), part_ml.get(), out, nb, nkvh, ns, lens.get(),
+            dst->nb[1], dst->nb[3]);
+        CUDA_CHECK(cudaGetLastError());
+        ++rg_calls;
+        if ((rg_calls & (rg_calls - 1)) == 0) {
+            fprintf(stderr, "ggml_cuda: occamy FA ragged on: engaged=%lld ns=%d n_kv=%d NB=%d nkvh=%d\n", rg_calls, ns, n_kv, nb, nkvh);
+        }
+        return;
+    }
+
     int nsplit = (resident*waves + nkvh*ns - 1) / (nkvh*ns);
     nsplit = std::max(1, std::min(nsplit, n_kv / (OFA_T*OFA_NW*4)));  // >= 64 tokens per block
 
