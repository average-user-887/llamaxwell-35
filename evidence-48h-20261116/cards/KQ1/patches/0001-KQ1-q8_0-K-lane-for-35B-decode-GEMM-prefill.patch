+static std::atomic<uint64_t> occamy_fa_gemm_kq8{0};     // KQ1: engaged ops with q8_0 keys (dequantised in staging)
 static constexpr int maxwell_gemm_max_chunk_queries = 1024; // scratch is sized for this many Q rows
