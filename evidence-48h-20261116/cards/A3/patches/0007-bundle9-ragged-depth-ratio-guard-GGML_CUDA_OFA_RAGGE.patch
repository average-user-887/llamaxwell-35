From 52c9e8465755cf09e06d46fa8366cb71e70ed588 Mon Sep 17 00:00:00 2001
From: author <noreply@example.invalid>
Date: Sun, 15 Nov 2026 22:22:57 +0100
Subject: [PATCH 7/8] bundle9: ragged depth-ratio guard
 (GGML_CUDA_OFA_RAGGED_RATIO, default 2)

---
 ggml/src/ggml-cuda/fattn-occamy.cu | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/ggml/src/ggml-cuda/fattn-occamy.cu b/ggml/src/ggml-cuda/fattn-occamy.cu
index d564f70..fd50ce8 100644
--- a/ggml/src/ggml-cuda/fattn-occamy.cu
+++ b/ggml/src/ggml-cuda/fattn-occamy.cu
@@ -16,6 +16,7 @@
 // in registers (64 fp32) and so does the output accumulator (64 fp32). K/V are read exactly once per block,
 // converted f16 -> f32 (no half math). QK partials (4 tokens x 8 heads = 32 per lane) are reduce-scattered
 // across the warp so lane l ends with score (token l>>3, head l&7). Partials (m, l, o) per block -> combine.
+#include <climits>
 #include "common.cuh"
 #include "fattn-occamy.cuh"
 #include "fattn-occamy-kvq8.cuh"
@@ -1178,6 +1179,20 @@ static void ofa_launch(ggml_backend_cuda_context & ctx, const ggml_tensor * dst,
         p.nbm1 = mask->nb[1]; p.nbm3 = mask->nb[3];
         ofa_len_kernel<<<ns, 1024, 0, stream>>>(p.mask, p.nbm3, p.mask_ne3, n_kv, lens.get());
         CUDA_CHECK(cudaGetLastError());
+        // bundle9 depth-ratio guard (GGML_CUDA_OFA_RAGGED_RATIO, default 2, 0 = off): every 64th call copy the stream lengths to the host
+        // (one sync) and cache whether max(L)/min(L) >= ratio; calls in between reuse the cached verdict. Below the ratio fall back to the stock split path.
+        static int rg_ratio = -1, rg_allow = 1; static long long rg_probe = 0, rg_guard_fb = 0;
+        if (rg_ratio < 0) { const char * e = getenv("GGML_CUDA_OFA_RAGGED_RATIO"); rg_ratio = e ? atoi(e) : 2; }
+        if (rg_ratio > 0 && (rg_probe++ & 63) == 0) {
+            int hl[8] = {0}; const int nn = std::min(ns, 8);
+            CUDA_CHECK(cudaMemcpyAsync(hl, lens.get(), nn*sizeof(int), cudaMemcpyDeviceToHost, stream));
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+            int lo = INT_MAX, hi = 0; for (int i = 0; i < nn; ++i) { lo = std::min(lo, std::max(hl[i], 1)); hi = std::max(hi, hl[i]); }
+            const int allow = (long long) hi >= (long long) rg_ratio * lo;
+            if (allow != rg_allow || rg_probe == 1) fprintf(stderr, "ggml_cuda: occamy FA ragged guard: Lmax=%d Lmin=%d ratio_req=%d -> %s\n", hi, lo, rg_ratio, allow ? "ragged" : "stock split");
+            rg_allow = allow;
+        }
+        if (rg_ratio > 0 && !rg_allow) { if ((++rg_guard_fb & (rg_guard_fb - 1)) == 0) fprintf(stderr, "ggml_cuda: occamy FA ragged guard fallbacks=%lld\n", rg_guard_fb); goto rg_skip; }
         ofa_decode_rg_kernel<<<dim3(nb, nkvh), 2*OFA_NT, 0, stream>>>(p, lens.get(), ns);
         CUDA_CHECK(cudaGetLastError());
         ofa_combine_rg_kernel<<<dim3(nkvh*OFA_G, ns), OFA_D, 0, stream>>>(part_o.get(), part_ml.get(), out, nb, nkvh, ns, lens.get(),
@@ -1189,6 +1204,7 @@ static void ofa_launch(ggml_backend_cuda_context & ctx, const ggml_tensor * dst,
         }
         return;
     }
+    rg_skip:;
 
     int nsplit = (resident*waves + nkvh*ns - 1) / (nkvh*ns);
     nsplit = std::max(1, std::min(nsplit, n_kv / (OFA_T*OFA_NW*4)));  // >= 64 tokens per block
