 };
 static n3_ledger g_n3l;
 
+// L1 stage events (LLAMA_N3_LEDGER set): t_start = epoch s at stage start, dur_ms = stage duration (0 for point events)
+static void n3l_stage(const char * stage, double t_start_s, double dur_ms, int slot = -1, int task = -1, long long aux = 0) {
+    if (!g_n3l.fs) return;
+    std::lock_guard<std::mutex> lk(g_n3l.mtx);
+    fprintf(g_n3l.fs, "%.6f,%s,%.3f,%d,%d,%lld\n", t_start_s, stage, dur_ms, slot, task, aux);
+    fflush(g_n3l.fs);
+}
+struct n3l_scope {
+    const char * stage; int slot, task; long long aux; double ts = 0.0; int64_t t0 = 0;
+    n3l_scope(const char * st, int sl = -1, int tk = -1, long long ax = 0) : stage(st), slot(sl), task(tk), aux(ax) {
+        if (g_n3l.fs) { ts = n3_ledger::now_s(); t0 = ggml_time_us(); }
+    }
+    ~n3l_scope() { if (g_n3l.fs) n3l_stage(stage, ts, (ggml_time_us() - t0) / 1000.0, slot, task, aux); }
+};
+
