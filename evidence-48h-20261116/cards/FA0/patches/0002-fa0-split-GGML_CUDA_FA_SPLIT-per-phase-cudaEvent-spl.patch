+
+enum { FA0_PACK, FA0_CONV, FA0_QK, FA0_SOFT, FA0_PV, FA0_RED, FA0_TOTAL, FA0_NPH };
+static const char * const fa0_names[FA0_NPH] = {"pack", "convert_kv", "qk_sgemm", "softmax_mask", "pv_sgemm", "reduce", "op_total"};
+static double fa0_ms[2][FA0_NPH]; static unsigned long long fa0_n[2], fa0_keys[2];
+static const char * fa0_file() { static const char * f = std::getenv("GGML_CUDA_FA_SPLIT"); return (f && *f) ? f : nullptr; }
+static void fa0_dump() {
+    FILE * f = std::fopen(fa0_file(), "w"); if (!f) return;
+    std::fprintf(f, "#bucket\tops\tkeys_sum\tphase\tms\n");
+    for (int b = 0; b < 2; ++b) for (int i = 0; i < FA0_NPH; ++i)
+        std::fprintf(f, "%s\t%llu\t%llu\t%s\t%.3f\n", b ? "keys_ge_81920" : "keys_lt_81920", fa0_n[b], fa0_keys[b], fa0_names[i], fa0_ms[b][i]);
+    std::fclose(f);
+}
+struct fa0_timer {
+    struct rec { int ph; cudaEvent_t a, b; };
+    std::vector<rec> r; cudaStream_t st; bool on; int open_ph = -1; cudaEvent_t oa = nullptr;
+    static std::vector<cudaEvent_t> & pool() { static std::vector<cudaEvent_t> p; return p; }
+    size_t used = 0;
+    cudaEvent_t ev() { auto & p = pool(); if (used == p.size()) { cudaEvent_t e; cudaEventCreate(&e); p.push_back(e); } return p[used++]; }
+    fa0_timer(cudaStream_t s) : st(s), on(fa0_file() != nullptr) {}
+    void begin(int ph) { if (!on) return; oa = ev(); cudaEventRecord(oa, st); open_ph = ph; }
+    cudaEvent_t ta = nullptr;
+    void begin_total() { if (!on) return; ta = ev(); cudaEventRecord(ta, st); }
+    void end() { if (!on || open_ph < 0) return; cudaEvent_t e = ev(); cudaEventRecord(e, st); r.push_back({open_ph, oa, e}); open_ph = -1; }
+    void finish(int key_count) {
+        if (!on) return;
+        { cudaEvent_t e = ev(); cudaEventRecord(e, st); r.push_back({FA0_TOTAL, ta, e}); }
+        cudaStreamSynchronize(st);
+        static bool reg = false; if (!reg) { reg = true; std::atexit(fa0_dump); }
+        const int b = key_count >= 81920;
+        for (auto & x : r) { float ms = 0; cudaEventElapsedTime(&ms, x.a, x.b); fa0_ms[b][x.ph] += ms; }
+        fa0_n[b]++; fa0_keys[b] += key_count;
+    }
+};
