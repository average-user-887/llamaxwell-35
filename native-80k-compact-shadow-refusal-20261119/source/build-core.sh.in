#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
here=$(cd -- "$(dirname -- "$0")" && pwd -P)
c=$(dirname -- "$here")
n40=$c/night-one-graph-draft
source_mount=@@OWNER_SOURCE_MOUNT@@
image=sha256:747c8a878fc2a36aca96e10da800f6cfe80d1e813c7e4af49ded30588be16bed
cd "$here"
python3 -B prepare-core.py
timeout -k 3s 210s docker run --rm --pull never --runtime runc --network none --cpuset-cpus 2 \
  --name "nmmoon-compact-core-$$" --tmpfs /tmp:rw,size=256m --user "$(id -u):$(id -g)" \
  -e NVIDIA_VISIBLE_DEVICES=void -e TMPDIR=/tmp -v "$n40/src:$source_mount:ro" \
  -v "$n40/build:/b:ro" -v "$here:/work" -w /b/src --entrypoint /bin/bash "$image" -euc '
    flags=CMakeFiles/llama.dir/flags.make
    read -ra defines <<< "$(sed -n "s/^CXX_DEFINES = //p" "$flags")"
    read -ra includes <<< "$(sed -n "s/^CXX_INCLUDES = //p" "$flags")"
    read -ra cxxflags <<< "$(sed -n "s/^CXX_FLAGS = //p" "$flags")"
    sed -e "s|\( -o \)../bin/libllama.so.0.6.0|\1/work/core-control.so|" CMakeFiles/llama.dir/link.txt > /work/core-control-link.sh
    bash /work/core-control-link.sh
    cmp /work/core-control.so /b/bin/libllama.so.0.6.0
    set -x
    /usr/bin/g++-14 "${defines[@]}" "${includes[@]}" "${cxxflags[@]}" -I/work \
      -o /work/llama-context.cpp.o -c /work/llama-context.cpp
    sed -e "s|/work/core-control.so|/work/libllama.so.0.6.0|" \
      -e "s|CMakeFiles/llama.dir/llama-context.cpp.o|/work/llama-context.cpp.o|" \
      /work/core-control-link.sh > /work/core-link.sh
    bash /work/core-link.sh
    nm -D --defined-only /work/libllama.so.0.6.0 | c++filt | grep llama_occamy_compact_decode
  ' > core-build.log 2>&1
