+#pragma unroll
+        for (int w=0;w<4;++w) {
+            end=max(end,ends[b][w]); bm|=invalids[b][w]; bs|=bad_scores[b][w];
+            best=fmaxf(best,maxscores[b][w]);
+        }
+        const size_t index=size_t(plan)*n_blocks+first+b;
+        scores[index]=best;
+        metas[index]={end,bm,bs};
     }
 }
 
