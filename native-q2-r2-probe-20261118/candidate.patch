+// Four consecutive original blocks per CTA. Warp w handles probe w in each block.
+__global__ void __launch_bounds__(128) ofa_sparse_probe_tile4(
+        ofa_params p, ofa_sparse_meta * metas, float * scores, int n_blocks) {
