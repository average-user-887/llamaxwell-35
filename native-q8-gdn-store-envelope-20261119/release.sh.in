#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
card=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
campaign=$(dirname -- "$card")
lab=$(dirname -- "$campaign")
runner=$campaign/runner
source "$runner/night_trial_runtime.sh"
runtime=$campaign/sparse/r2/libs
cd -- "$card"
[[ $# == 1 && ($1 == --check || $1 == --run) ]] || exit 2
sha256sum --check --quiet FROZEN.sha256
sha256sum --check --quiet INPUTS.sha256
python3 -B verify.py | cmp build.json -
if [[ $1 == --check ]]; then
  echo 'Exact Q8 GDN store envelope offline checks passed.'
  exit
fi

night_lock_gpu
start=$(date +%s)
deadline=$((start + 180))
if [[ -n ${ROOT_GPU_DEADLINE_EPOCH:-} ]]; then
  [[ $ROOT_GPU_DEADLINE_EPOCH =~ ^[0-9]+$ ]] || exit 2
  (( deadline <= ROOT_GPU_DEADLINE_EPOCH )) || exit 124
fi
id=$(date -u +%Y%m%dT%H%M%SZ)-$$
out=$card/receipts/$id
name=nmmoon-gdn-envelope-$id
mkdir -p -- "$out"
printf 'GDN_ENVELOPE_RECEIPT=%s\n' "$out"

finish() {
  local status=$? cleanup=0 remaining done
  trap - EXIT INT TERM
  remaining=$(timeout -k 1s 3s docker ps -aq --filter "name=^/$name$" --filter "label=gdn.envelope.owner=$id") || cleanup=1
  if [[ -n $remaining ]]; then
    if [[ $remaining =~ ^[0-9a-f]+$ ]]; then
      timeout -k 1s 5s docker rm -f "$remaining" >> "$out/cleanup.log" 2>&1 || cleanup=1
    else
      cleanup=1
    fi
  fi
  remaining=$(timeout -k 1s 3s docker ps -aq --filter "name=^/$name$") || cleanup=1
  [[ -z $remaining ]] || cleanup=1
  done=$(date +%s)
  (( done <= deadline )) || status=124
  printf 'runner_exit=%d\ncleanup_exit=%d\nstarted_epoch=%d\nfinished_epoch=%d\ncap_seconds=180\n'       "$status" "$cleanup" "$start" "$done" > "$out/status.txt"
  (cd "$out" && find . -maxdepth 1 -type f ! -name observations.sha256 -print0 | sort -z | xargs -0 sha256sum) > "$out/observations.sha256"
  (( cleanup == 0 )) || exit 125
  exit "$status"
}
trap finish EXIT
trap 'exit 124' INT TERM

admitted=0
for attempt in 1 2 3; do
  if night_admit_idle >> "$out/admission.txt" 2>&1; then admitted=1; break; fi
  if (( attempt < 3 )); then sleep 3; fi
done
(( admitted == 1 )) || exit 90
cp build.json FROZEN.sha256 INPUTS.sha256 RELEASE.md "$out"
left=$((deadline - $(date +%s) - 20))
(( left > 0 )) || exit 124
timeout -k 2s "${left}s" docker run --pull never --name "$name" --label "gdn.envelope.owner=$id"   --network none --device "nvidia.com/gpu=$N3_GPU" --cpuset-cpus 0-1   -v "$runtime:/runtime:ro" -v "$card:/candidate:ro" -e LD_LIBRARY_PATH=/runtime   --entrypoint /bin/sh "$night_image" -ec '
     sha256sum /runtime/libggml-base.so.0.26.0 /candidate/libggml-cuda.so /candidate/probe.py
     exec nice -n 19 python3 -B /candidate/probe.py
  ' > "$out/operator.log" 2>&1
python3 -B report.py "$out" > "$out/result.json"
