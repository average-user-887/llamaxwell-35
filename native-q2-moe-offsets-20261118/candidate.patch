+            const int row = t >> 2, q = t & 3;
+            float a = 0.f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                const int e = q * (QK / 4) + lane + 32 * i;
+                const float4 xv = *(const float4 *)(xs + ((4 * e) >> 6) * CH + ((4 * e) & 63));
