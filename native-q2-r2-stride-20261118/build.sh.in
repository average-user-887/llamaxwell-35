#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
cd -- "$(dirname -- "$0")"
here=$(pwd -P)
c=$(dirname "$here")
base=$c/sparse/r2
source=@CUDA_BUILD_SOURCE_MOUNT@
image=sha256:747c8a878fc2a36aca96e10da800f6cfe80d1e813c7e4af49ded30588be16bed
python3 -B prepare.py
timeout -k 2s 290s taskset -c 2-3 nice -n 19 docker run --rm --pull never --runtime runc --network none --cpuset-cpus 2-3 --tmpfs /tmp:rw,size=512m --user "$(id -u):$(id -g)" -e NVIDIA_VISIBLE_DEVICES=void -e TMPDIR=/tmp \
  -v "$base/src:$source:ro" -v "$here/fattn-occamy-sparse.cuh:$source/ggml/src/ggml-cuda/fattn-occamy-sparse.cuh:ro" -v "$base/build:/b:ro" \
  -v "$c/last-ms-r2-selector/fattn-occamy.cu.o:/fast/fattn-occamy.cu.o:ro" -v "$c/resume-q2-moe-cohorts/occamy-fused.cu.o:/control/occamy-fused.cu.o:ro" -v "$c/night-gdn-t2-q8-fast/occamy-gdn.cu.o:/q8/occamy-gdn.cu.o:ro" \
  -v "$here:/work" -w /work --entrypoint /bin/bash "$image" -euc 'nice -n 19 bash /work/compile.sh' > build.log 2>&1
cmp control-relinked.so "$c/last-ms-r2-selector/libggml-cuda.so"
