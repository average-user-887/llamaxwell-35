+        const char * mask, size_t mask_row_stride, int key_count, int total_queries, int * tile_eff_keys) {
+    const int q_lo = int(blockIdx.x) * maxwell_gemm_tile_queries;
+    const int q_hi = min(total_queries, q_lo + maxwell_gemm_tile_queries);
+    __shared__ int warp_best[8];
+    __shared__ int smem_best;
+    for (int k_base = ((key_count - 1) / 256) * 256; k_base >= 0; k_base -= 256) {
