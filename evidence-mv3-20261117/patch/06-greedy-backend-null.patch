From d60bf17f991665784b69dbd6fa3337b475886f4b Mon Sep 17 00:00:00 2001
From: claude <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 19:37:03 +0100
Subject: [PATCH] sampling: LLAMA_GREEDY_BACKEND=1 runs greedy argmax in the
 target graph

At temp 0 the CPU chain reduces to argmax(logits + bias). With the env set,
a greedy-only backend chain (logit_bias if any + greedy) is attached to the
target slot, so the full-vocab logits D2H copy and the host sampling loop are
skipped; common_sampler_sample returns the backend token id directly.
Grammar, reasoning budget, n_probs>0 and non-greedy chains keep the CPU path.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012TpXXDKesx6WqrHo8bCYxx
---
 common/sampling.cpp             | 38 +++++++++++++++++++++++++++++++++
 common/sampling.h               |  3 +++
 tools/server/server-context.cpp |  4 ++++
 3 files changed, 45 insertions(+)

diff --git a/common/sampling.cpp b/common/sampling.cpp
index 9e16693..6c7e05f 100644
--- a/common/sampling.cpp
+++ b/common/sampling.cpp
@@ -170,6 +170,9 @@ struct common_sampler {
     }
 
     mutable int64_t t_total_us = 0;
+
+    // greedy-only backend chain (LLAMA_GREEDY_BACKEND=1): the argmax runs in the target graph, only token ids come back
+    struct llama_sampler * bchain = nullptr;
 };
 
 std::string common_params_sampling::print() const {
@@ -210,6 +213,8 @@ struct common_sampler * common_sampler_init(
     llama_sampler * grmr = nullptr;
     llama_sampler * rbudget = nullptr;
     llama_sampler * chain = llama_sampler_chain_init(lparams);
+    llama_sampler * bchain = nullptr;
+    std::vector<llama_logit_bias> bchain_bias;
 
     std::vector<llama_sampler *> samplers;
 
@@ -336,6 +341,8 @@ struct common_sampler * common_sampler_init(
             merged.push_back({ suppress[i], -INFINITY });
         }
 
+        bchain_bias = merged;
+
         if (!merged.empty()) {
             samplers.push_back(llama_sampler_init_logit_bias(llama_vocab_n_tokens(vocab), merged.size(), merged.data()));
         }
@@ -404,6 +411,19 @@ struct common_sampler * common_sampler_init(
                 ((params.samplers.back() == COMMON_SAMPLER_TYPE_TEMPERATURE && params.temp == 0.0f && params.dynatemp_range == 0.0f) ||
                  (params.samplers.back() == COMMON_SAMPLER_TYPE_TOP_K && params.top_k == 1));
             samplers.push_back(greedy ? llama_sampler_init_greedy() : llama_sampler_init_dist(params.seed));
+
+            // at temp 0 every sampler before greedy keeps the max logit, so the chain is argmax(logits + bias)
+            static const bool greedy_backend = [] {
+                const char * e = getenv("LLAMA_GREEDY_BACKEND");
+                return e && atoi(e) != 0;
+            }();
+            if (greedy && greedy_backend && !grmr && !rbudget) {
+                bchain = llama_sampler_chain_init(lparams);
+                if (!bchain_bias.empty()) {
+                    llama_sampler_chain_add(bchain, llama_sampler_init_logit_bias(llama_vocab_n_tokens(vocab), bchain_bias.size(), bchain_bias.data()));
+                }
+                llama_sampler_chain_add(bchain, llama_sampler_init_greedy());
+            }
         }
     } else if (params.mirostat == 1) {
         samplers.push_back(llama_sampler_init_temp(params.temp));
@@ -442,6 +462,7 @@ struct common_sampler * common_sampler_init(
         // mix it, the chain and the draft are seeded from this one too
         /* .rng     = */ std::mt19937(llama_sampler_get_seed(chain) ^ 0x9e3779b9u),
     };
+    result->bchain = bchain;
 
     return result;
 }
@@ -454,6 +475,7 @@ void common_sampler_free(struct common_sampler * gsmpl) {
     llama_sampler_free(gsmpl->grmr);
     llama_sampler_free(gsmpl->rbudget);
     llama_sampler_free(gsmpl->chain);
+    llama_sampler_free(gsmpl->bchain);
 
     delete gsmpl;
 }
@@ -594,6 +616,10 @@ void common_perf_print(const struct llama_context * ctx, const struct common_sam
     }
 }
 
+struct llama_sampler * common_sampler_get_backend_greedy(const struct common_sampler * gsmpl) {
+    return gsmpl ? gsmpl->bchain : nullptr;
+}
+
 struct llama_sampler * common_sampler_get(const struct common_sampler * gsmpl) {
     if (!gsmpl) {
         return nullptr;
@@ -615,6 +641,18 @@ llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_co
     auto & chain = gsmpl->chain;
     auto & cur_p = gsmpl->cur_p; // initialized by set_logits
 
+    // a greedy backend chain returns only the token id: skip the full-vocab host copy into cur
+    if (gsmpl->bchain && !gsmpl->grmr && !gsmpl->rbudget &&
+            llama_get_sampled_probs_ith(ctx, idx) == nullptr && llama_get_sampled_logits_ith(ctx, idx) == nullptr) {
+        id = llama_get_sampled_token_ith(ctx, idx);
+        if (id != LLAMA_TOKEN_NULL) {
+            gsmpl->cur.resize(1);
+            gsmpl->cur[0] = llama_token_data{id, 0.0f, 1.0f};
+            cur_p = { gsmpl->cur.data(), 1, 0, false };
+            return id;
+        }
+    }
+
     gsmpl->set_logits(ctx, idx);
 
     // Check if a backend sampler has already sampled a token in which case we
diff --git a/common/sampling.h b/common/sampling.h
index f19bd27..5e66e51 100644
--- a/common/sampling.h
+++ b/common/sampling.h
@@ -55,6 +55,9 @@ void common_perf_print(const struct llama_context * ctx, const struct common_sam
 // get the underlying llama_sampler_chain
 struct llama_sampler * common_sampler_get(const struct common_sampler * gsmpl);
 
+// greedy-only backend chain, or nullptr (set when LLAMA_GREEDY_BACKEND=1 and the chain is greedy without grammar/budget)
+struct llama_sampler * common_sampler_get_backend_greedy(const struct common_sampler * gsmpl);
+
 // extended sampling implementation:
 //
 // - set logits
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index cde5a23..36c9c57 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -1991,8 +1991,12 @@ private:
             use_backend_sampling &= !need_pre_sample_logits;
 
             // TODO: tmp until backend sampling is fully implemented
+            llama_sampler * greedy_bs = need_pre_sample_logits ? nullptr : common_sampler_get_backend_greedy(slot.smpl.get());
+
             if (use_backend_sampling) {
                 llama_set_sampler(ctx_tgt, slot.id, common_sampler_get(slot.smpl.get()));
+            } else if (greedy_bs) {
+                llama_set_sampler(ctx_tgt, slot.id, greedy_bs);
             } else {
                 llama_set_sampler(ctx_tgt, slot.id, nullptr);
             }
