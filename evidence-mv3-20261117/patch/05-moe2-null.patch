+// GGML_CUDA_MOE_PHASE_TIME=N (debug): stamp phases of moe_v3 / moe_v3x2 launches, sync after each, print the mean
+// phase durations (us) every N launches per kind. Serialises the stream: diagnostic runs only.
+static int phase_time_n() { static const int n = getenv("GGML_CUDA_MOE_PHASE_TIME") ? atoi(getenv("GGML_CUDA_MOE_PHASE_TIME")) : 0; return n; }
+static unsigned long long * phase_buf() {
+    static unsigned long long * b = nullptr;
+    if (!b) { CUDA_CHECK(cudaMalloc((void **)&b, 8 * sizeof(unsigned long long))); }
+    return b;
+}
+static void phase_pre(cudaStream_t st, unsigned long long * b) {
+    CUDA_CHECK(cudaMemsetAsync(b, 0, 8 * sizeof(unsigned long long), st));
+    CUDA_CHECK(cudaMemsetAsync(b, 0xFF, sizeof(unsigned long long), st));
+}
+static void phase_post(cudaStream_t st, unsigned long long * b, int kind) {
+    static double acc[2][6]; static int cnt[2];
+    unsigned long long t[8];
+    CUDA_CHECK(cudaMemcpyAsync(t, b, sizeof(t), cudaMemcpyDeviceToHost, st));
+    CUDA_CHECK(cudaStreamSynchronize(st));
+    const int seg[6][2] = { {0, 1}, {1, 2}, {2, 3}, {3, 4}, {4, 5}, {0, 5} };
+    for (int i = 0; i < 6; ++i) {
+        const unsigned long long a = t[seg[i][0]], e = t[seg[i][1]];
+        acc[kind][i] += (a && e && e >= a && a != ~0ull) ? (e - a) * 1e-3 : 0.0;
+    }
+    if (++cnt[kind] % phase_time_n() == 0) {
+        const double n = cnt[kind];
+        fprintf(stderr, "occamy-fused PHASE %s n=%d us: A %.1f B %.1f bar2 %.1f C0 %.1f C1 %.1f total %.1f\n", kind ? "v3x2" : "v3",
+                cnt[kind], acc[kind][0] / n, acc[kind][1] / n, acc[kind][2] / n, acc[kind][3] / n, acc[kind][4] / n, acc[kind][5] / n);
+    }
+}
