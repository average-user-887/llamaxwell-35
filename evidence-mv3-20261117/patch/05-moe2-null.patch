 ggml/src/ggml-cuda/ggml-cuda.cu     |   6 +-
 ggml/src/ggml-cuda/occamy-fused.cu  | 374 ++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/occamy-fused.cuh |   1 +
 tests/test-backend-ops.cpp          | 109 ++++++++
 4 files changed, 488 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index b03793d..02a6481 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -3969,8 +3969,10 @@ static int ggml_cuda_try_fuse(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph
         if (ggml_cuda_occamy_moe_match_window(*cuda_ctx, cgraph, i, m)) {
             if (mv1::mode()) { mv1::R().add("WINDOW " + mv1::tag() + " moe_matched nt=" + std::to_string(m.nt) + " n_nodes=" + std::to_string(m.n_nodes)); }
             if (m.nt == 2) {   // D1b N2SPLIT: MoE is per-token independent; one fused launch per row
-                ggml_cuda_occamy_moe_launch(*cuda_ctx, m, nullptr, 0);
-                ggml_cuda_occamy_moe_launch(*cuda_ctx, m, nullptr, 1);
+                if (!ggml_cuda_occamy_moe_launch_x2(*cuda_ctx, m)) {
+                    ggml_cuda_occamy_moe_launch(*cuda_ctx, m, nullptr, 0);
+                    ggml_cuda_occamy_moe_launch(*cuda_ctx, m, nullptr, 1);
+                }
                 cuda_ctx->q8r_valid = false;
                 cuda_ctx->q8r_pend  = false;
                 return m.n_nodes - 1;
diff --git a/ggml/src/ggml-cuda/occamy-fused.cu b/ggml/src/ggml-cuda/occamy-fused.cu
index 8f00199..65dcd54 100644
--- a/ggml/src/ggml-cuda/occamy-fused.cu
+++ b/ggml/src/ggml-cuda/occamy-fused.cu
@@ -53,7 +53,12 @@ struct Params {
     float * out;
     Scratch * s;
     float eps;
+    unsigned long long * tdbg = nullptr;   // GGML_CUDA_MOE_PHASE_TIME: per-phase globaltimer stamps (debug only)
 };
+// phase stamp: slot 0 = earliest start (min), others = latest arrival (max) over blocks
+#define OCC_TS(i) do { if (P.tdbg && threadIdx.x == 0) { unsigned long long t_; \
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t_)); \
+    if ((i) == 0) atomicMin(&P.tdbg[0], t_); else atomicMax(&P.tdbg[(i)], t_); } } while (0)
 
 __device__ __forceinline__ float silu(float x) { return x / (1.0f + __expf(-x)); }
 __device__ __forceinline__ float wsum(float v) {
@@ -491,6 +496,7 @@ __global__ void __launch_bounds__(NT3, 2) moe_v3(Params P) {
     const int gw = blockIdx.x * NW3 + warp, W = gridDim.x * NW3;
     Scratch * s = P.s;
     const Layer & L = P.L;
+    OCC_TS(0);
 
     // A: rmsnorm + router logits / shexp-gate quarter-row partials (per task identical to moe_v2)
     {
@@ -512,6 +518,7 @@ __global__ void __launch_bounds__(NT3, 2) moe_v3(Params P) {
             if (t + W < NTA) ldA(L, t + W, lane, cw);
         }
     }
+    OCC_TS(1);
     grid_barrier(s);
     // B: route; gate row chunk, then up row chunk, per row
     {
@@ -550,7 +557,9 @@ __global__ void __launch_bounds__(NT3, 2) moe_v3(Params P) {
 #pragma unroll
         for (int q = 0; q < NQ; ++q) gl += gp[q];
     }
+    OCC_TS(2);
     grid_barrier(s);
+    OCC_TS(3);
     {
         constexpr int NX = (TOPK * FF + FFS) / NT3, NXE = TOPK * FF / NT3;
         float hv[NX];
@@ -591,6 +600,7 @@ __global__ void __launch_bounds__(NT3, 2) moe_v3(Params P) {
         if (lane == 0) P.out[r] = P.h[r] + acc;
         __syncwarp();
     }
+    OCC_TS(5);
 }
 __global__ void moe_v3_cmp(const float * a, const float * b, unsigned * res) {
     for (int i = threadIdx.x; i < H; i += blockDim.x) {
@@ -599,6 +609,254 @@ __global__ void moe_v3_cmp(const float * a, const float * b, unsigned * res) {
     }
 }
 
+// MOE2 card B, DB variant: one lane's 36 bytes (= lds9(stg + 9 lane) of a staged row) read straight from global,
+// skipping the smem staging round trip.
+__device__ __forceinline__ Q9 ldg9(const uint8_t * row, int lane) { Q9 q;
+    const unsigned * p = (const unsigned *)row + 9 * lane;
+#pragma unroll
+    for (int i = 0; i < 9; ++i) q.w[i] = __ldg(p + i);
+    return q; }
+// dot2c<L3> of two weight rows (gate, up) against the same activations: every xs float4 is read once for both.
+// Per row the FMA chains, their order and the final combine are dot2c's -> same bits.
+template <bool L3>
+__device__ __forceinline__ void dot2c_gu(const Q9 & qg, const Q9 & qu, const float * xc, float2 sx, float & rg, float & ru) {
+    float dg0 = __half2float(__ushort_as_half((unsigned short)(qg.w[0] & 0xFFFF)));
+    float dg1 = __half2float(__ushort_as_half((unsigned short)(qg.w[4] >> 16)));
+    float du0 = __half2float(__ushort_as_half((unsigned short)(qu.w[0] & 0xFFFF)));
+    float du1 = __half2float(__ushort_as_half((unsigned short)(qu.w[4] >> 16)));
+    float g0 = 0.f, g1 = 0.f, u0 = 0.f, u1 = 0.f;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const unsigned pg = __byte_perm(qg.w[i], qg.w[i + 1], 0x5432), pu = __byte_perm(qu.w[i], qu.w[i + 1], 0x5432);
+        unsigned glo = L3 ? unpk(pg) : (pg & 0x0F0F0F0Fu) | 0x80808080u, ghi = L3 ? unpk(pg >> 4) : ((pg >> 4) & 0x0F0F0F0Fu) | 0x80808080u;
+        unsigned ulo = L3 ? unpk(pu) : (pu & 0x0F0F0F0Fu) | 0x80808080u, uhi = L3 ? unpk(pu >> 4) : ((pu >> 4) & 0x0F0F0F0Fu) | 0x80808080u;
+        float4 xl = *(const float4 *)(xc + 4 * i), xh = *(const float4 *)(xc + 16 + 4 * i);
+        g0 = fmaf(nib(glo, 0), xl.x, g0); g0 = fmaf(nib(glo, 1), xl.y, g0); g0 = fmaf(nib(glo, 2), xl.z, g0); g0 = fmaf(nib(glo, 3), xl.w, g0);
+        u0 = fmaf(nib(ulo, 0), xl.x, u0); u0 = fmaf(nib(ulo, 1), xl.y, u0); u0 = fmaf(nib(ulo, 2), xl.z, u0); u0 = fmaf(nib(ulo, 3), xl.w, u0);
+        g0 = fmaf(nib(ghi, 0), xh.x, g0); g0 = fmaf(nib(ghi, 1), xh.y, g0); g0 = fmaf(nib(ghi, 2), xh.z, g0); g0 = fmaf(nib(ghi, 3), xh.w, g0);
+        u0 = fmaf(nib(uhi, 0), xh.x, u0); u0 = fmaf(nib(uhi, 1), xh.y, u0); u0 = fmaf(nib(uhi, 2), xh.z, u0); u0 = fmaf(nib(uhi, 3), xh.w, u0);
+        const unsigned qg1 = qg.w[5 + i], qu1 = qu.w[5 + i];
+        glo = L3 ? unpk(qg1) : (qg1 & 0x0F0F0F0Fu) | 0x80808080u; ghi = L3 ? unpk(qg1 >> 4) : ((qg1 >> 4) & 0x0F0F0F0Fu) | 0x80808080u;
+        ulo = L3 ? unpk(qu1) : (qu1 & 0x0F0F0F0Fu) | 0x80808080u; uhi = L3 ? unpk(qu1 >> 4) : ((qu1 >> 4) & 0x0F0F0F0Fu) | 0x80808080u;
+        xl = *(const float4 *)(xc + 32 + 4 * i); xh = *(const float4 *)(xc + 48 + 4 * i);
+        g1 = fmaf(nib(glo, 0), xl.x, g1); g1 = fmaf(nib(glo, 1), xl.y, g1); g1 = fmaf(nib(glo, 2), xl.z, g1); g1 = fmaf(nib(glo, 3), xl.w, g1);
+        u1 = fmaf(nib(ulo, 0), xl.x, u1); u1 = fmaf(nib(ulo, 1), xl.y, u1); u1 = fmaf(nib(ulo, 2), xl.z, u1); u1 = fmaf(nib(ulo, 3), xl.w, u1);
+        g1 = fmaf(nib(ghi, 0), xh.x, g1); g1 = fmaf(nib(ghi, 1), xh.y, g1); g1 = fmaf(nib(ghi, 2), xh.z, g1); g1 = fmaf(nib(ghi, 3), xh.w, g1);
+        u1 = fmaf(nib(uhi, 0), xh.x, u1); u1 = fmaf(nib(uhi, 1), xh.y, u1); u1 = fmaf(nib(uhi, 2), xh.z, u1); u1 = fmaf(nib(uhi, 3), xh.w, u1);
+    }
+    rg = dg0 * (128.f * g0 - 136.f * sx.x) + dg1 * (128.f * g1 - 136.f * sx.y);
+    ru = du0 * (128.f * u0 - 136.f * sx.x) + du1 * (128.f * u1 - 136.f * sx.y);
+}
+
+// MOE2 card B (GGML_CUDA_MOE_V3X2=1, default off): both rows of a two-token (MTP verify) MoE window in ONE moe_v3
+// launch instead of two. A: the router / shexp-gate weights are read once and dotted with both rows' normed inputs.
+// B: the union of the two rows' top-8 experts (<= 16) plus the shared expert is walked once; every gate/up weight row
+// is staged once and dotted with each row that selected it. C: down per row, one after the other (both rows'
+// activations do not fit 48 KB smem). Per row every dot keeps moe_v3's lane mapping, dot2c form and sum order
+// -> bitwise identical to two moe_v3 launches (GGML_CUDA_MOE_V3X2_CHECK=N verifies). Scratch: row r uses P.s[r];
+// the grid barrier uses P.s[0] only. Row 1 input/output at P.h + H / P.out + H.
+template <bool L3>
+__device__ __forceinline__ void down3(const Layer & L, const Scratch * s, const int * sel, const float * selw, float gl,
+                                      const float * h, float * out, float * xs, float2 * sums, unsigned * stg,
+                                      uint4 (&cv)[3], int r, int W, bool sync) {
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    uint4 * stg4 = (uint4 *)stg;
+    {
+        constexpr int NX = (TOPK * FF + FFS) / NT3, NXE = TOPK * FF / NT3;
+        float hv[NX];
+#pragma unroll
+        for (int j = 0; j < NX; ++j) {
+            const int i = threadIdx.x + NT3 * j;
+            hv[j] = j < NXE ? __ldcg(&s->h_exp[i]) : __ldcg(&s->h_sh[i - TOPK * FF]);
+        }
+        if (sync) __syncthreads();   // every warp is done reading the previous row's xs / sums
+#pragma unroll
+        for (int j = 0; j < NX; ++j) {
+            const int i = threadIdx.x + NT3 * j;
+            xs[(i >> 6) * CH + (i & 63)] = hv[j];
+            const float sm = wsum(hv[j]);
+            if (lane == 0) ((float *)sums)[NW3 * j + warp] = sm;
+        }
+        __syncthreads();
+    }
+    const float gs = 1.f / (1.f + expf(-gl));
+    const float w0 = selw[lane >> 3], w1 = selw[(lane >> 3) + 4];
+    for (; r < H; r += W) {
+        st72(stg4, lane, cv);
+        __syncwarp();
+        ldD(L, sel, r, 1, lane, cv);
+        const float dA = dot2c<L3, true>(lds9(stg + lane * 9), xs + lane * CH, sums[lane]);
+        __syncwarp();
+        st72(stg4, lane, cv);
+        __syncwarp();
+        ldD(L, sel, r, 2, lane, cv);
+        const float dB = dot2c<L3, true>(lds9(stg + lane * 9), xs + (lane + 32) * CH, sums[lane + 32]);
+        __syncwarp();
+        if (lane < 18) stg4[lane] = cv[0];
+        __syncwarp();
+        if (r + W < H) ldD(L, sel, r + W, 0, lane, cv);
+        float acc = __fmaf_rn(w0, dA, __fmul_rn(w1, dB));
+        if (lane < 8) acc = __fmaf_rn(gs, dot2c<L3, true>(lds9(stg + lane * 9), xs + (lane + 64) * CH, sums[lane + 64]), acc);
+        acc = wsum(acc);
+        if (lane == 0) out[r] = h[r] + acc;
+        __syncwarp();
+    }
+}
+
+template <bool L3, bool DB = false>
+__global__ void __launch_bounds__(NT3, 2) moe_v3x2(Params P) {
+    extern __shared__ float smem[];
+    __shared__ int sel[TOPK], sel1[TOPK];
+    __shared__ float selw[TOPK], selw1[TOPK];
+    __shared__ int ue[2 * TOPK], ua[2 * TOPK], ub[2 * TOPK];
+    __shared__ int nu;
+    __shared__ float red[NW];
+    float * xs = smem;
+    float * xs1 = smem + (H / 64) * CH;   // row 1 normed input (A, B); 2 x 2176 floats fit the 4896-float region
+    float2 * sums = (float2 *)(smem + (TOPK * FF + FFS) / 64 * CH);
+    float2 * sums1 = sums + H / 64;      // row 1 group sums (32 float2)
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    unsigned * stg = (unsigned *)(smem + SMEM_FLOATS) + warp * STW3;
+    uint4 * stg4 = (uint4 *)stg;
+    const int gw = blockIdx.x * NW3 + warp, W = gridDim.x * NW3;
+    Scratch * s0 = P.s, * s1 = P.s + 1;
+    const Layer & L = P.L;
+    OCC_TS(0);
+
+    // A: rmsnorm of both rows; each router / shexp-gate quarter row is loaded once and dotted with both rows
+    {
+        float4 cw[4];
+        int t = gw;
+        if (t < NTA) ldA(L, t, lane, cw);
+        load_norm3(xs, sums, P.h, P.norm, red, P.eps);
+        load_norm3(xs1, sums1, P.h + H, P.norm, red, P.eps);
+        for (; t < NTA; t += W) {
+            const int row = t >> 2, q = t & 3;
+            float a = 0.f, b = 0.f;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                const int e = q * (QK / 4) + lane + 32 * i;
+                const int o = ((4 * e) >> 6) * CH + ((4 * e) & 63);
+                const float4 xv = *(const float4 *)(xs + o);
+                a = fmaf(cw[i].x, xv.x, a); a = fmaf(cw[i].y, xv.y, a); a = fmaf(cw[i].z, xv.z, a); a = fmaf(cw[i].w, xv.w, a);
+                const float4 yv = *(const float4 *)(xs1 + o);
+                b = fmaf(cw[i].x, yv.x, b); b = fmaf(cw[i].y, yv.y, b); b = fmaf(cw[i].z, yv.z, b); b = fmaf(cw[i].w, yv.w, b);
+            }
+            a = wsum(a);
+            b = wsum(b);
+            if (lane == 0) {
+                if (row < NE) { s0->lpart[q][row] = a; s1->lpart[q][row] = b; }
+                else { s0->gpart[q] = a; s1->gpart[q] = b; }
+            }
+            if (t + W < NTA) ldA(L, t + W, lane, cw);
+        }
+    }
+    OCC_TS(1);
+    grid_barrier(s0);
+    // B: route both rows; walk shexp rows + union-of-experts rows once (gate chunk, then up chunk)
+    {
+        uint4 cv[3];
+        bool have = false;
+        const uint8_t * g, * u;
+        if (!DB && gw < FFS) { g = L.gate_sh + (size_t)gw * ROW_GU; u = L.up_sh + (size_t)gw * ROW_GU; ld72(g, lane, cv); have = true; }
+        if (warp == 0) route(s0, lane, sel, selw);
+        else if (warp == 1) route(s1, lane, sel1, selw1);
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            int n = 0;
+            for (int a = 0; a < TOPK; ++a) {
+                int bb = -1;
+                for (int b = 0; b < TOPK; ++b) if (sel1[b] == sel[a]) bb = b;
+                ue[n] = sel[a]; ua[n] = a; ub[n] = bb; ++n;
+            }
+            for (int b = 0; b < TOPK; ++b) {
+                bool f = false;
+                for (int a = 0; a < TOPK; ++a) f |= sel[a] == sel1[b];
+                if (!f) { ue[n] = sel1[b]; ua[n] = -1; ub[n] = b; ++n; }
+            }
+            nu = n;
+        }
+        __syncthreads();
+        const int NTB2 = FFS + nu * FF;
+        const float * xc0 = xs + lane * CH, * xc1 = xs1 + lane * CH;
+        const float2 sx0 = sums[lane], sx1 = sums1[lane];
+        if (DB) for (int t = gw; t < NTB2; t += W) {
+            int a = 0, b = 0, rr = t;
+            const uint8_t * gp, * up;
+            if (t < FFS) { gp = L.gate_sh + (size_t)t * ROW_GU; up = L.up_sh + (size_t)t * ROW_GU; }
+            else {
+                const int k = (t - FFS) / FF; rr = (t - FFS) % FF; a = ua[k]; b = ub[k];
+                const size_t off = ((size_t)ue[k] * FF + rr) * ROW_GU; gp = L.gate_exps + off; up = L.up_exps + off;
+            }
+            const Q9 qg = ldg9(gp, lane), qu = ldg9(up, lane);
+            float gg0 = 0.f, gg1 = 0.f, uu0 = 0.f, uu1 = 0.f;
+            if (a >= 0) { dot2c_gu<L3>(qg, qu, xc0, sx0, gg0, uu0); gg0 = wsum(gg0); uu0 = wsum(uu0); }
+            if (b >= 0) { dot2c_gu<L3>(qg, qu, xc1, sx1, gg1, uu1); gg1 = wsum(gg1); uu1 = wsum(uu1); }
+            if (lane == 0) {
+                if (t < FFS) { s0->h_sh[t] = silu(gg0) * uu0; s1->h_sh[t] = silu(gg1) * uu1; }
+                else {
+                    if (a >= 0) s0->h_exp[a * FF + rr] = silu(gg0) * uu0;
+                    if (b >= 0) s1->h_exp[b * FF + rr] = silu(gg1) * uu1;
+                }
+            }
+        }
+        if (DB) { (void) have; (void) cv; }
+        else for (int t = gw; t < NTB2; t += W) {
+            int a = 0, b = 0, rr = t;
+            if (t >= FFS) { const int k = (t - FFS) / FF; rr = (t - FFS) % FF; a = ua[k]; b = ub[k]; }
+            if (!have) {
+                const size_t off = ((size_t)ue[(t - FFS) / FF] * FF + rr) * ROW_GU;
+                g = L.gate_exps + off; u = L.up_exps + off; ld72(g, lane, cv);
+            }
+            st72(stg4, lane, cv);
+            __syncwarp();
+            ld72(u, lane, cv);
+            float gg0 = 0.f, gg1 = 0.f, uu0 = 0.f, uu1 = 0.f;
+            if (a >= 0) gg0 = wsum(dot2c<L3>(lds9(stg + lane * 9), xc0, sx0));
+            if (b >= 0) gg1 = wsum(dot2c<L3>(lds9(stg + lane * 9), xc1, sx1));
+            __syncwarp();
+            st72(stg4, lane, cv);
+            __syncwarp();
+            const int tn = t + W; have = tn < NTB2;
+            if (have) {
+                if (tn < FFS) { g = L.gate_sh + (size_t)tn * ROW_GU; u = L.up_sh + (size_t)tn * ROW_GU; }
+                else { const size_t off = ((size_t)ue[(tn - FFS) / FF] * FF + (tn - FFS) % FF) * ROW_GU; g = L.gate_exps + off; u = L.up_exps + off; }
+                ld72(g, lane, cv);
+            }
+            if (a >= 0) uu0 = wsum(dot2c<L3>(lds9(stg + lane * 9), xc0, sx0));
+            if (b >= 0) uu1 = wsum(dot2c<L3>(lds9(stg + lane * 9), xc1, sx1));
+            if (lane == 0) {
+                if (t < FFS) { s0->h_sh[t] = silu(gg0) * uu0; s1->h_sh[t] = silu(gg1) * uu1; }
+                else {
+                    if (a >= 0) s0->h_exp[a * FF + rr] = silu(gg0) * uu0;
+                    if (b >= 0) s1->h_exp[b * FF + rr] = silu(gg1) * uu1;
+                }
+            }
+            __syncwarp();
+        }
+    }
+    // C: down, row 0 then row 1 (first chunk of each warp's first row + both shexp gate logits before barrier 2)
+    const int r = warp * gridDim.x + blockIdx.x;
+    uint4 cv[3];
+    if (r < H) ldD(L, sel, r, 0, lane, cv);
+    float gl0 = 0.f, gl1 = 0.f;
+    {
+        float gp[NQ], gq[NQ];
+#pragma unroll
+        for (int q = 0; q < NQ; ++q) { gp[q] = __ldcg(&s0->gpart[q]); gq[q] = __ldcg(&s1->gpart[q]); }
+#pragma unroll
+        for (int q = 0; q < NQ; ++q) { gl0 += gp[q]; gl1 += gq[q]; }
+    }
+    OCC_TS(2);
+    grid_barrier(s0);
+    OCC_TS(3);
