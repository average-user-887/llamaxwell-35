+// Experimental two-row counterpart; only enabled for the exact microvalidated shape.
+template <int block_size>
+static __global__ void rms_norm_mul_q8_1_pair(const float * x, const float * mul, float * dst, block_q8_1 * q8,
+                                             const int ncols, const float eps) {
+    x += blockIdx.x*ncols; dst += blockIdx.x*ncols; q8 += blockIdx.x*(ncols/QK8_1);
+    extern __shared__ float s_sum[];
+    const int tid = threadIdx.x;
+    float tmp = 0.0f;
+    for (int col = tid; col < ncols; col += block_size) {
+        tmp += x[col] * x[col];
+    }
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(tmp / ncols + eps);
+    for (int col = tid; col < ncols; col += block_size) {
+        const float xi = scale * x[col] * mul[col];
+        dst[col] = xi;
+        const float amax = warp_reduce_max<QK8_1>(fabsf(xi));
+        const float sum = warp_reduce_sum<QK8_1>(xi);
+        const float d = amax / 127.0f;
+        q8[col / QK8_1].qs[col % QK8_1] = amax == 0.0f ? 0 : roundf(xi / d);
+        if (col % QK8_1 == 0) {
+            q8[col / QK8_1].ds = make_half2(d, sum);
+        }
+    }
+}
