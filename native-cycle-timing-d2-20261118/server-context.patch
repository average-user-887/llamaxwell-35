 static mv1_host_t g_mv1;
+
+// Diagnostic-only one-slot timing. Host call boundaries only. No extra backend wait.
+namespace {
+
+enum class native_stage {
+    draft, target_decode, target_output_wait, cache_process, sample, checkpoint_save,
+    target_trim, draft_trim, target_load, draft_load, sampler_restore, count
+};
+
+struct native_cycle_timing {
+    struct stage {
+        long long first = -1, last = -1, total = 0, calls = 0;
+    };
+    FILE * file = nullptr;
+    long long origin = -1, begin = -1, previous_end = -1, gap = -1, cycle = 0, request = 0;
+    int task = -1;
+    size_t offered = 0, accepted = 0, emitted = 0;
+    bool replay = false, checkpoint = false, verified = false, timer_active = false;
+    stage costs[static_cast<int>(native_stage::count)] = {};
+
+    native_cycle_timing() {
+        const char * path = getenv("LLAMA_NATIVE_CYCLE_TIMING");
+        if (!path || !path[0]) { return; }
+        file = fopen(path, "w");
+        GGML_ASSERT(file);
+        fprintf(file, "cycle\trequest\tbegin_us\tspan_us\tgap_us\treplay\tverified\toffered\taccepted\temitted\tcheckpoint");
+        const char * names[] = {"draft", "target_decode", "target_output_wait", "cache_process", "sample",
+                                "checkpoint_save", "target_trim", "draft_trim", "target_load", "draft_load",
+                                "sampler_restore"};
+        static_assert(sizeof(names) / sizeof(names[0]) == static_cast<int>(native_stage::count));
+        for (const char * name : names) {
+            fprintf(file, "\t%s_first_us\t%s_last_us\t%s_us\t%s_calls", name, name, name, name);
+        }
+        fprintf(file, "\tother_us\n");
+        fflush(file);
+    }
+
+    ~native_cycle_timing() {
+        if (file) { fclose(file); }
+    }
+
+    void start(int task_id, bool is_replay) {
+        GGML_ASSERT(begin < 0);
+        begin = ggml_time_us();
+        if (origin < 0) { origin = begin; }
+        if (task != task_id) {
+            task = task_id;
+            ++request;
+            previous_end = -1;
+        }
+        gap = previous_end >= 0 ? begin - previous_end : -1;
+        offered = accepted = emitted = 0;
+        replay = is_replay;
+        checkpoint = verified = false;
+        for (auto & value : costs) { value = {}; }
+    }
+
+    void add(native_stage kind, long long first, long long last) {
+        auto & value = costs[static_cast<int>(kind)];
+        if (!value.calls) { value.first = first - begin; }
+        value.last = last - begin;
+        value.total += last - first;
+        ++value.calls;
+    }
+
+    void finish() {
+        if (begin < 0) { return; }
+        GGML_ASSERT(!timer_active);
+        const long long end = ggml_time_us();
+        previous_end = end;
+        const long long span = end - begin;
+        fprintf(file, "%lld\t%lld\t%lld\t%lld\t%lld\t%d\t%d\t%zu\t%zu\t%zu\t%d",
+                ++cycle, request, begin - origin, span, gap, replay, verified, offered, accepted, emitted, checkpoint);
+        long long subtotal = 0;
+        for (const auto & value : costs) {
+            fprintf(file, "\t%lld\t%lld\t%lld\t%lld", value.first, value.last, value.total, value.calls);
+            subtotal += value.total;
+        }
+        GGML_ASSERT(span >= subtotal);
+        fprintf(file, "\t%lld\n", span - subtotal);
+        if ((cycle & 127) == 0) { fflush(file); }
+        begin = -1;
+    }
+};
+
+static native_cycle_timing g_native_cycle;
+
+struct native_stage_timer {
+    native_stage kind;
+    long long start;
+    explicit native_stage_timer(native_stage which) : kind(which), start(g_native_cycle.begin >= 0 ? ggml_time_us() : -1) {
+        if (start >= 0) {
+            GGML_ASSERT(!g_native_cycle.timer_active);
+            g_native_cycle.timer_active = true;
+        }
+    }
+    ~native_stage_timer() {
+        if (start >= 0) {
+            g_native_cycle.add(kind, start, ggml_time_us());
+            g_native_cycle.timer_active = false;
+        }
+    }
+};
+
+struct native_iteration_end {
+    ~native_iteration_end() { g_native_cycle.finish(); }
+};
+
+template <typename Function>
+static decltype(auto) native_timed(native_stage which, Function && function) {
+    native_stage_timer timer(which);
+    return function();
+}
