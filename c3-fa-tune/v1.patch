+static int occamy_fa_gemm_env_int(const char * name, int def, std::initializer_list<int> allowed) {
+    const char * v = std::getenv(name);
+    if (!v || !*v) return def;
+    const int x = std::atoi(v);
+    for (int a : allowed) if (a == x) return x;
+    return def;
