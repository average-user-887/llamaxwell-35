+// Diagnostic only. Use the existing q2 and q1 launchers as row-wise references.
+// The input is head-permuted and the target writes [D,head,row,1].
+static void ofa_sparse_check_three_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    const size_t count = (size_t) ggml_nelements(dst);
+    ggml_cuda_pool_alloc<float> scratch(ctx.pool(), count);
+    const size_t row_values = count / 3;
+    for (int first : {0, 2}) {
+        const int width = first == 0 ? 2 : 1;
+        ggml_tensor view = *dst, query = *dst->src[0], mask = *dst->src[3];
+        query.data = (char *)query.data + first * query.nb[1];
+        mask.data = (char *)mask.data + first * mask.nb[1];
+        view.data = scratch.get() + first * row_values;
+        query.ne[1] = mask.ne[1] = view.ne[2] = width;
+        view.src[0] = &query;
+        view.src[3] = &mask;
+        if (width == 2) ofa_sparse_launch<2>(ctx, &view);
+        else ofa_sparse_launch<1>(ctx, &view);
+    }
+    std::vector<float> actual(count), reference(count);
+    cudaStream_t stream = ctx.stream();
+    CUDA_CHECK(cudaMemcpyAsync(actual.data(), dst->data, count*sizeof(float), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaMemcpyAsync(reference.data(), scratch.get(), count*sizeof(float), cudaMemcpyDeviceToHost, stream));
+    CUDA_CHECK(cudaStreamSynchronize(stream));
+    for (int row = 0; row < 3; ++row) {
+        float max_abs = 0.0f, max_ref = 0.0f;
+        size_t nonfinite = 0, failed = 0;
+        for (size_t col = 0; col < row_values; ++col) {
+            const size_t i = row*row_values + col;
+            const float a = actual[i], b = reference[i], delta = fabsf(a-b);
+            if (!std::isfinite(a) || !std::isfinite(b)) { ++nonfinite; continue; }
+            if (delta > 2e-5f*(1.0f + fabsf(b))) ++failed;
+            max_abs = std::max(max_abs, delta);
+            max_ref = std::max(max_ref, fabsf(b));
+        }
+        fprintf(stderr, "n98_q3_check row=%d count=%zu nonfinite=%zu failed=%zu max_abs=%.9g max_ref=%.9g q_stride=%zu mask_stride=%zu out_stride=%zu\n",
+                row, row_values, nonfinite, failed, max_abs, max_ref, dst->src[0]->nb[1], dst->src[3]->nb[1], dst->nb[2]);
+        GGML_ASSERT(nonfinite == 0 && failed == 0);
+    }
+}
+
 void ggml_cuda_occamy_fa_sparse(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (dst->src[0]->ne[1] == 3) {
+        ofa_sparse_launch<3>(ctx, dst);
+        static const bool check = [] {
+            const char * value = getenv("GGML_CUDA_OCCAMY_FA_Q3_R2_CHECK");
+            return value && strcmp(value, "1") == 0;
+        }();
+        if (check) {
+            static std::atomic<unsigned> checked{0};
+            if (checked.fetch_add(1) == 0) ofa_sparse_check_three_rows(ctx, dst);
+        }
+        return;
+    }
     if (dst->src[0]->ne[1] == 1) ofa_sparse_launch<1>(ctx, dst);
     else ofa_sparse_launch<2>(ctx, dst);
 }
