+    if (o == GGML_OP_MUL_MAT || o == GGML_OP_MUL_MAT_ID) { k += " w=" + mv1_strip(t->src[0]->name) + ":" + ggml_type_name(t->src[0]->type) + " x=" + mv1_shape(t->src[1]); }
+    else { for (int j = 0; j < 3 && t->src[j]; j++) k += " s" + std::to_string(j) + "=" + mv1_shape(t->src[j]); }
+    mv1::R().add(k);
