+        CUDA_CHECK(cudaMemcpyAsync(host_plans.data(), plans.get(), nplans*sizeof(ofa_sparse_plan), cudaMemcpyDeviceToHost, stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
