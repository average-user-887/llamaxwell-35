set(CMAKE_BUILD_TYPE Release CACHE STRING "")
set(CMAKE_C_COMPILER gcc-14 CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER g++-14 CACHE FILEPATH "")
set(CMAKE_CUDA_HOST_COMPILER g++-14 CACHE FILEPATH "")
set(CMAKE_CUDA_ARCHITECTURES 52-real CACHE STRING "")
set(CMAKE_CUDA_FLAGS "-Xptxas -v" CACHE STRING "")
set(BUILD_SHARED_LIBS ON CACHE BOOL "")
set(GGML_CUDA ON CACHE BOOL "")
set(GGML_CUDA_FA ON CACHE BOOL "")
set(GGML_CUDA_FA_ALL_QUANTS OFF CACHE BOOL "")
set(GGML_CUDA_FA_QUANTS "q4_0-q4_0;q8_0-q8_0;f16-f16;bf16-bf16" CACHE STRING "")
set(GGML_CUDA_COMPRESSION_MODE size CACHE STRING "")
set(GGML_BACKEND_DL ON CACHE BOOL "")
set(GGML_CPU_ALL_VARIANTS ON CACHE BOOL "")
set(GGML_NATIVE OFF CACHE BOOL "")
set(LLAMA_CURL OFF CACHE BOOL "")
set(LLAMA_BUILD_SERVER ON CACHE BOOL "")
set(LLAMA_BUILD_TESTS ON CACHE BOOL "")
set(LLAMA_BUILD_MTMD OFF CACHE BOOL "")
set(LLAMA_BUILD_UI OFF CACHE BOOL "")
