#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
cd -- "$(dirname -- "$0")"
here=$(pwd -P)
base=$(dirname "$here")/sparse/r2
source=@SOURCE_MOUNT@
image=sha256:747c8a878fc2a36aca96e10da800f6cfe80d1e813c7e4af49ded30588be16bed
python3 -B prepare-host.py
timeout -k 2s 290s taskset -c 2-3 nice -n 19 docker run --rm --pull never --runtime runc --network none --cpuset-cpus 2-3 --tmpfs /tmp:rw,size=512m --user "$(id -u):$(id -g)" -e NVIDIA_VISIBLE_DEVICES=void -e TMPDIR=/tmp \
  -v "$base/src:$source:ro" -v "$here/test-backend-ops.cpp:$source/tests/test-backend-ops.cpp:ro" -v "$base/build:/b:ro" \
  -v "$here:/work" -w /work --entrypoint /bin/bash "$image" -euc 'nice -n 19 bash /work/compile-host.sh' > build-host.log 2>&1
