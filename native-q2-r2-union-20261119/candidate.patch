+template <unsigned TOKEN_BYTES>
+__global__ void __launch_bounds__(512,1) ofa_sparse_union_fallback(const ofa_params p, ofa_sparse_plan * plans) {
+    __shared__ int eligible;
+    if (threadIdx.x==0) eligible=ofa_union_eligible(plans,blockIdx.y,p.n_kv);
+    __syncthreads();
+    if (eligible) return;
+    constexpr int NQ = 2, NU = 4;
+    static_assert(TOKEN_BYTES == 1024 || TOKEN_BYTES == 2048, "Unexpected retained KV layout");
+    constexpr int HG = 4, NG = 2*NQ;
+    constexpr int NT = 32*NU*NG;
+    const int split = blockIdx.x;
+    const int kvh   = blockIdx.y;
+    constexpr int i3 = 0;
+    const int wid   = threadIdx.x >> 5;
+    const int ul    = wid % NU;      // unit lane
+    const int g     = wid / NU;
+    const int lane  = threadIdx.x & 31;
+    const int row = g/2, head_group = g%2;
+
+    __shared__ __align__(16) float s_p[NU*NG][OFA_T*4];
+    __shared__ __align__(16) float s_a[NU*NG][4];
+    __shared__ __align__(16) float s_o[NU][OFA_G][OFA_D];
+    __shared__ float s_m[NU][NQ*OFA_G];
+    __shared__ float s_l[NU][NQ*OFA_G];
