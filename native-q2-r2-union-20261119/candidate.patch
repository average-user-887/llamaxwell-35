+    // Four query slots per warp, mapped to one or two query rows.
+    float q[4][8];
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const float4 * qp = (const float4 *) (p.Q + i3*p.nbq3 + (size_t) row*p.nbq1 + (size_t)(kvh*OFA_G + HG*head_group + k)*p.nbq2) + 2*lane;
+        const float4 a = qp[0], b = qp[1];
+        q[k][0] = a.x*p.scale_log2; q[k][1] = a.y*p.scale_log2; q[k][2] = a.z*p.scale_log2; q[k][3] = a.w*p.scale_log2;
+        q[k][4] = b.x*p.scale_log2; q[k][5] = b.y*p.scale_log2; q[k][6] = b.z*p.scale_log2; q[k][7] = b.w*p.scale_log2;
+    }
+    float o[4][8];
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) o[k][i] = 0.0f;
+    }
+    const int jl = lane >> 3;            // token in the unit whose score this lane owns
+    const int rl = row;
+    float m_run = -FLT_MAX/2.0f;
+    float l_run = 0.0f;
+
+    const char * Kb = p.K + unsigned(kvh)*512u + unsigned(lane)*16u;
+    const char * Vb = p.V + unsigned(kvh)*512u + unsigned(lane)*16u;
+    const half * Mb = (const half *) (p.mask + (rl == 0 ? size_t(0) : p.nbm1));
+
+    const int plan_index = row*p.nkvh + kvh;
+    const ofa_sparse_plan & plan = plans[plan_index];
+    int use_sparse = 0;
+    if (lane == 0) {
+        use_sparse = ofa_sparse_plan_valid(plan, p.n_kv);
+        // Eight warps in this CTA validate exactly the same immutable row/head plan.
+        if (head_group == 0 && ul == 0) {
+            if (use_sparse) atomicAdd(&plans[plan_index].sparse_warps, 2*NU);
+            else {
+                atomicExch(&plans[plan_index].fallback, 1);
+                atomicAdd(&plans[plan_index].full_warps, 2*NU);
+            }
+        }
+    }
+    use_sparse = __shfl_sync(0xFFFFFFFF, use_sparse, 0, 32);
+    // Each lane holds one original far-block ID. The old IDs, boundary and
+    // split counts are immutable for every warp consuming this plan.
+    const int old_blocks = use_sparse ? plan.n_blocks : 0;
+    const int old_units = old_blocks*(OFS_BLOCK/OFA_T);
+    const int recent_begin = use_sparse ? plan.recent_begin : 0;
+    const int lane_block = lane < old_blocks ? plan.blocks[lane] : 0;
+    const int nunits = use_sparse ? plan.units : p.n_kv/OFA_T;
