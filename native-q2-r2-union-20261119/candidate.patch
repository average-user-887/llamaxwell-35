+__global__ void __launch_bounds__(OFA_D) ofa_union_combine(const float * __restrict__ part_o, const float2 * __restrict__ part_ml,
+        char * __restrict__ dst, const ofa_sparse_plan * plans, const int n_kv, const int nkvh, const int nq, const size_t nbd1, const size_t nbd2, const size_t nbd3) {
+    const int qh = blockIdx.x, r = blockIdx.y, i3 = blockIdx.z, d = threadIdx.x;
+    const int kvh = qh / OFA_G, h = qh % OFA_G;
+    const int S = OFA_G*nq, slot = r*OFA_G + h;
+    __shared__ int nsplit;
+    if (threadIdx.x==0) nsplit=ofa_union_eligible(plans,kvh,n_kv) ? 24 : 12;
+    __syncthreads();
+    const int blk0=(i3*nkvh+kvh)*24;
+    float M = -FLT_MAX;
+    for (int s = 0; s < nsplit; ++s) M = fmaxf(M, part_ml[(size_t)(blk0 + s)*S + slot].x);
+    float L = 0.0f, acc = 0.0f;
+    for (int s = 0; s < nsplit; ++s) {
+        const float2 ml = part_ml[(size_t)(blk0 + s)*S + slot];
+        const float  w  = exp2f(ml.x - M);
+        L   += ml.y*w;
+        acc += part_o[((size_t)(blk0 + s)*S + slot)*OFA_D + d]*w;
+    }
+    float * out = (float *) (dst + i3*nbd3 + (size_t) r*nbd2 + (size_t) qh*nbd1);
+    out[d] = L > 0.0f ? acc/L : 0.0f;
+}
