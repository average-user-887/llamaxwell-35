From 826fae7f444acb410a7ee68fb97bcab7cb5725bc Mon Sep 17 00:00:00 2001
From: average-user-887 <average-user-887@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:20:01 +0100
Subject: [PATCH 1/5] feat(server): add opt-in mixed prompt batch cap [skip ci]

Keep pure prefill and generation unchanged. The measured benefit is competing-stream responsiveness, not free throughput or guaranteed output equivalence.

Assisted-by: Codex
(cherry picked from commit 4041db989acf4ce653175b1af59a3c8d9c5674a1)
---
 common/arg.cpp                  | 11 +++++++++++
 common/common.h                 |  1 +
 tests/test-arg-parser.cpp       | 15 +++++++++++++++
 tools/server/server-context.cpp | 11 ++++++++++-
 4 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index 7c1b81e..fb47afe 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -1682,6 +1682,17 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.n_ubatch = value;
         }
     ).set_env("LLAMA_ARG_UBATCH"));
+    add_opt(common_arg(
+        {"--mixed-batch-size"}, "N",
+        "maximum total batch size when adding splittable text prompts to generation (default: 0, disabled); "
+        "limited to the logical and physical batch sizes; pure prefill is unchanged",
+        [](common_params & params, int value) {
+            if (value < 0) {
+                throw std::invalid_argument("--mixed-batch-size must be non-negative");
+            }
+            params.n_batch_mixed = value;
+        }
+    ).set_env("LLAMA_ARG_MIXED_BATCH_SIZE").set_examples({LLAMA_EXAMPLE_SERVER}));
     add_opt(common_arg(
         {"--keep"}, "N",
         string_format("number of tokens to keep from the initial prompt (default: %d, -1 = all)", params.n_keep),
diff --git a/common/common.h b/common/common.h
index d89f803..5f912cc 100644
--- a/common/common.h
+++ b/common/common.h
@@ -455,6 +455,7 @@ struct common_params {
     int32_t n_ctx                 =     0; // context size, 0 == context the model was trained with
     int32_t n_batch               =  2048; // logical batch size for prompt processing (must be >=32 to use BLAS)
     int32_t n_ubatch              =   512; // physical batch size for prompt processing (must be >=32 to use BLAS)
+    int32_t n_batch_mixed         =     0;
     int32_t n_keep                =     0; // number of tokens to keep from initial prompt
     int32_t n_chunks              =    -1; // max number of chunks to process (-1 = unlimited)
     int32_t n_parallel            =     1; // number of parallel sequences to decode
diff --git a/tests/test-arg-parser.cpp b/tests/test-arg-parser.cpp
index e090763..9a8eb89 100644
--- a/tests/test-arg-parser.cpp
+++ b/tests/test-arg-parser.cpp
@@ -172,6 +172,21 @@ static void test(void) {
 
     std::vector<std::string> argv;
 
+    {
+        common_params mixed_params;
+        assert(mixed_params.n_batch_mixed == 0);
+        argv = {"binary_name", "--mixed-batch-size", "1024"};
+        assert(true == common_params_parse(argv.size(), list_str_to_char(argv).data(), mixed_params, LLAMA_EXAMPLE_SERVER));
+        assert(mixed_params.n_batch_mixed == 1024);
+        argv = {"binary_name", "--mixed-batch-size", "0"};
+        assert(true == common_params_parse(argv.size(), list_str_to_char(argv).data(), mixed_params, LLAMA_EXAMPLE_SERVER));
+        assert(mixed_params.n_batch_mixed == 0);
+        argv = {"binary_name", "--mixed-batch-size", "-1"};
+        assert(false == common_params_parse(argv.size(), list_str_to_char(argv).data(), mixed_params, LLAMA_EXAMPLE_SERVER));
+        argv = {"binary_name", "--mixed-batch-size", "invalid"};
+        assert(false == common_params_parse(argv.size(), list_str_to_char(argv).data(), mixed_params, LLAMA_EXAMPLE_SERVER));
+    }
+
     printf("test-arg-parser: test invalid usage\n\n");
 
     // missing value
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 44aaadd..dc03d6f 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -3466,6 +3466,7 @@ private:
         // process in chunks of params.n_batch
         int32_t n_batch  = llama_n_batch(ctx_tgt);
         int32_t n_ubatch = llama_n_ubatch(ctx_tgt);
+        const int32_t n_generation = batch.size();
 
         auto & alora_scale       = batch.alora_scale;
         auto & alora_disabled_id = batch.alora_disabled_id;
@@ -3497,6 +3498,14 @@ private:
                 // this slot still has a prompt to be processed
                 if (slot.state == SLOT_STATE_PROCESSING_PROMPT || slot.state == SLOT_STATE_STARTED) {
                     const auto & input_tokens = slot.task->tokens;
+                    int32_t n_batch_prompt = n_batch;
+                    if (params_base.n_batch_mixed > 0 && n_generation > 0 && slot.can_split() &&
+                        slot.task->type == SERVER_TASK_TYPE_COMPLETION && !input_tokens.has_mtmd) {
+                        n_batch_prompt = std::min({n_batch, n_ubatch, params_base.n_batch_mixed});
+                        if (batch.size() >= n_batch_prompt) {
+                            return;
+                        }
+                    }
 
                     // used to determine the number of tokens added to the batch for the current slot
                     const auto n_tokens_prev = batch.size();
@@ -3940,7 +3949,7 @@ private:
                     const int32_t n_decision_first = slot.task->type == SERVER_TASK_TYPE_DECISION ? slot.task->decision.pos_first() : -1;
 
                     // add prompt tokens for processing in the current batch
-                    while (slot.prompt.n_tokens() < slot.task->n_tokens() && batch.size() < n_batch) {
+                    while (slot.prompt.n_tokens() < slot.task->n_tokens() && batch.size() < n_batch_prompt) {
                         // get next token to process
                         llama_token cur_tok = input_tokens[slot.prompt.n_tokens()];
                         if (cur_tok == LLAMA_TOKEN_NULL) {
