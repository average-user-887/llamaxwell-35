+__device__ __forceinline__ void router_barrier(Scratch * s) {
+    __threadfence();
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        volatile unsigned * genp = &s->bar_gen;
+        unsigned gen = *genp;
+        __threadfence();
+        if (atomicAdd(&s->bar_count, 1) == gridDim.x * gridDim.y - 1) {
+            s->bar_count = 0;
+            __threadfence();
+            atomicAdd(&s->bar_gen, 1);
+        } else {
+            unsigned k = 0;
+            while (*genp == gen) {
+                if (++k > SPIN_LIMIT) { __trap(); }
+            }
+        }
+        __threadfence();
+    }
+    __syncthreads();
+}
+__global__ void __launch_bounds__(NT3, 2) moe_q2_router(Params P, bool capture_ids) {
+    const int physical=blockIdx.y*gridDim.x+blockIdx.x;
