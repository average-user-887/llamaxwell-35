+            st72(stg4, lane, cv);
+            __syncwarp();
+            ld_down4(L, sel, r, k + 4, lane, cv);
+            const int ua = k * 8 + group;
+            const float dA = dot2c<true, true>(lds9(stg + lane * 9), xs + ua * CH, sums[ua]);
+            __syncwarp();
+            st72(stg4, lane, cv);
+            __syncwarp();
