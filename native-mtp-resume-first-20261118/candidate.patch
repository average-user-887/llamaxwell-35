+static bool q3_enabled(ggml_backend_cuda_context & ctx) {
+    const char * value = getenv("GGML_CUDA_OCCAMY_MOE_Q3_COHORTS");
+    return value && strcmp(value, "1") == 0 && ggml_cuda_info().devices[ctx.device].cc == 520 &&
+           env_flag("GGML_CUDA_MOE_V3") && !env_flag("GGML_CUDA_OCCAMY_3L") &&
+           ctx.curr_stream_no == 0 && ctx.stream_context().concurrent_events.empty();
+}
+
+static bool q3_resident(int device) {
+    static std::once_flag once[GGML_CUDA_MAX_DEVICES];
+    static bool available[GGML_CUDA_MAX_DEVICES] = {};
+    std::call_once(once[device], [device] {
+        ggml_cuda_set_device(device);
+        int nsm = 0, per_sm = 0;
+        cudaFuncAttributes attr{};
+        CUDA_CHECK(cudaDeviceGetAttribute(&nsm, cudaDevAttrMultiProcessorCount, device));
+        CUDA_CHECK(cudaFuncGetAttributes(&attr, moe_v3_q3_cohorts));
+        CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(
+            &per_sm, moe_v3_q3_cohorts, NT3, SMEM3_FLOATS * sizeof(float)));
+        available[device] = nsm == 24 && per_sm >= 2 && nsm*per_sm >= 48;
+        fprintf(stderr, "Q3_COHORT residency device=%d sm=%d active_per_sm=%d regs=%d "
+                "static_smem=%zu dynamic_smem=%zu local=%zu admitted=%d\n",
+                device, nsm, per_sm, attr.numRegs, attr.sharedSizeBytes,
+                SMEM3_FLOATS*sizeof(float), attr.localSizeBytes, int(available[device]));
+    });
+    return available[device];
+}
 
