+// Each group has gridDim.x members and its own two barrier counters.
+// Neighboring physical CTAs work on the same logical tile for different rows.
+__global__ void __launch_bounds__(NT3, 2) moe_v3_q3_cohorts(Params P) {
+    const unsigned physical = blockIdx.y * gridDim.x + blockIdx.x;
+    const unsigned row = physical % 3;
+    P.h += row * H;
+    P.out += row * H;
+    P.s += row;
+    moe_v3_body<true>(P, physical / 3);
+}
